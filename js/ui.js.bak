/**
 * UI Renderer Module
 */

window.App = window.App || {};

// Helper: Update Favorites Badge
window.updateFavoritesBadge = function () {
    if (!window.App.getFavorites) return;
    const favoriteCount = window.App.getFavorites().length;

    // Find all favorite nav buttons (desktop/mobile)
    const navBtns = document.querySelectorAll('.nav-btn[data-view="favorites"]');
    navBtns.forEach(navBtn => {
        // Remove existing badge
        const existingBadge = navBtn.querySelector('.nav-badge');
        if (existingBadge) existingBadge.remove();

        // Add new badge if count > 0
        if (favoriteCount > 0) {
            const badge = document.createElement('span');
            badge.className = 'nav-badge';
            badge.textContent = favoriteCount;
            navBtn.appendChild(badge);
        }
    });
};

// RENDER: CLINICAL & PATHOLOGIES VIEW (Multi-Step Wizard)
// RENDER: PROGRAMMING UI (v3 - Single Page Grid)
// RENDER: PROGRAMMING UI (v3 - Redesign)

window.App.renderWizard = function (containerId, onSubmit) {
    const container = document.getElementById(containerId);
    if (!container) return;

    // ── Restore any pathologies pre-loaded from the Clinical view ──
    let preloadedInjuries = [];
    try {
        const temp = localStorage.getItem('t7_temp_pathologies');
        if (temp) { preloadedInjuries = JSON.parse(temp); localStorage.removeItem('t7_temp_pathologies'); }
    } catch (_) {}

    // ── Restore any previously saved params ──
    let saved = {};
    try {
        const raw = localStorage.getItem('t7_prog_params');
        if (raw) saved = JSON.parse(raw);
        if (preloadedInjuries.length) saved.injuries = preloadedInjuries;
    } catch (_) {}

    const TOTAL_STEPS = 5;
    let currentStep = 1;

    // Pathologies are handled by ClinicalManager

    // ── RENDER ──
    container.innerHTML = `
        <div class="intake-wrapper">
            <aside class="intake-sidebar">
                <div class="intake-logo">✨</div>
                <h2 class="intake-sidebar-title">Programmazione<br>Intelligente</h2>
                <p class="intake-sidebar-sub">Rispondi a 5 domande guidate. L'IA costruirà la scheda perfetta per te.</p>
                <nav class="intake-steps-nav" id="steps-nav">
                    ${['Chi sei?', 'Struttura', 'Salute', 'Obiettivi', 'Stile'].map((label, i) => `
                        <div class="step-nav-item ${i === 0 ? 'active' : ''}" data-step="${i+1}">
                            <div class="step-nav-dot">${i+1}</div>
                            <span>${label}</span>
                        </div>`).join('')}
                </nav>
            </aside>

            <main class="intake-main">
                <div class="intake-progress-bar-wrap">
                    <div class="intake-progress-bar" id="intake-pbar" style="width:20%"></div>
                </div>

                <!-- STEP 1: Chi sei? -->
                <section class="intake-step-panel active" id="step-1">
                    <div class="intake-step-header">
                        <span class="step-emoji">👤</span>
                        <div><h3>Chi sei?</h3><p>Dimmi chi usa questo programma così posso adattare tutto al tuo profilo.</p></div>
                    </div>
                    <div class="intake-field-group">
                        <label class="intake-label">Tipo di Soggetto</label>
                        <div class="intake-cards-grid">
                            <label class="intake-option-card ${(saved.patientType||'Atleta')==='Atleta'?'selected':''}">
                                <input type="radio" name="patientType" value="Atleta" ${(saved.patientType||'Atleta')==='Atleta'?'checked':''}><span class="option-icon">🏋️</span><strong>Atleta / Fitness</strong><small>Cerco performance, massa o forza</small></label>
                            <label class="intake-option-card ${saved.patientType==='Clinico'?'selected':''}">
                                <input type="radio" name="patientType" value="Clinico" ${saved.patientType==='Clinico'?'checked':''}><span class="option-icon">🩺</span><strong>Paziente Clinico</strong><small>Ho patologie o necessito riabilitazione</small></label>
                            <label class="intake-option-card ${saved.patientType==='Anziano'?'selected':''}">
                                <input type="radio" name="patientType" value="Anziano" ${saved.patientType==='Anziano'?'checked':''}><span class="option-icon">👵</span><strong>Senior (60+)</strong><small>Mantenimento e mobilità</small></label>
                            <label class="intake-option-card ${saved.patientType==='Junior'?'selected':''}">
                                <input type="radio" name="patientType" value="Junior" ${saved.patientType==='Junior'?'checked':''}><span class="option-icon">🧒</span><strong>Junior (&lt; 18 anni)</strong><small>Programma età evolutiva</small></label>
                        </div>
                    </div>
                    <div class="intake-field-group">
                        <label class="intake-label">Esperienza di Allenamento</label>
                        <div class="intake-cards-grid cols-4">
                            <label class="intake-option-card ${saved.level==='Beginner'?'selected':''}"><input type="radio" name="level" value="Beginner" ${saved.level==='Beginner'?'checked':''}><span class="option-icon">🌱</span><strong>Principiante</strong><small>0 – 6 mesi</small></label>
                            <label class="intake-option-card ${(saved.level==='Intermediate'||!saved.level)?'selected':''}"><input type="radio" name="level" value="Intermediate" ${(saved.level==='Intermediate'||!saved.level)?'checked':''}><span class="option-icon">⚡</span><strong>Intermedio</strong><small>6 – 24 mesi</small></label>
                            <label class="intake-option-card ${saved.level==='Advanced'?'selected':''}"><input type="radio" name="level" value="Advanced" ${saved.level==='Advanced'?'checked':''}><span class="option-icon">🔥</span><strong>Avanzato</strong><small>&gt; 2 anni</small></label>
                            <label class="intake-option-card ${saved.level==='Elite'?'selected':''}"><input type="radio" name="level" value="Elite" ${saved.level==='Elite'?'checked':''}><span class="option-icon">🏆</span><strong>Elite</strong><small>Competitivo</small></label>
                        </div>
                    </div>
                </section>

                <!-- STEP 2: Struttura -->
                <section class="intake-step-panel" id="step-2">
                    <div class="intake-step-header">
                        <span class="step-emoji">📅</span>
                        <div><h3>Come vuoi allenarti?</h3><p>Definiamo la struttura settimanale, l'attrezzatura e il profilo di forza.</p></div>
                    </div>
                    <div class="intake-field-group">
                        <label class="intake-label">Giorni disponibili a settimana</label>
                        <div class="intake-cards-grid cols-5">
                            ${[2,3,4,5,6].map(d=>`<label class="intake-option-card compact ${(saved.days||3)==d?'selected':''}"><input type="radio" name="days" value="${d}" ${(saved.days||3)==d?'checked':''}><strong class="day-num">${d}</strong><small>${{2:'Full Body',3:'PPL',4:'Upper/Lower',5:'Hybrid',6:'PPL×2'}[d]}</small></label>`).join('')}
                        </div>
                    </div>
                    <div class="intake-field-group">
                        <label class="intake-label">Attrezzatura disponibile</label>
                        <div class="intake-cards-grid cols-4">
                            <label class="intake-option-card ${(saved.equipment||'Full')==='Full'?'selected':''}"><input type="radio" name="equipment" value="Full" ${(saved.equipment||'Full')==='Full'?'checked':''}><span class="option-icon">🏋️‍♀️</span><strong>Palestra Completa</strong><small>Tutto disponibile</small></label>
                            <label class="intake-option-card ${saved.equipment==='Minimal'?'selected':''}"><input type="radio" name="equipment" value="Minimal" ${saved.equipment==='Minimal'?'checked':''}><span class="option-icon">🔨</span><strong>Minimal</strong><small>Bilanciere + Manubri</small></label>
                            <label class="intake-option-card ${saved.equipment==='Calisthenics'?'selected':''}"><input type="radio" name="equipment" value="Calisthenics" ${saved.equipment==='Calisthenics'?'checked':''}><span class="option-icon">🤸</span><strong>Corpo Libero</strong><small>Calisthenics</small></label>
                            <label class="intake-option-card ${saved.equipment==='Home'?'selected':''}"><input type="radio" name="equipment" value="Home" ${saved.equipment==='Home'?'checked':''}><span class="option-icon">🏠</span><strong>Home Gym</strong><small>Attrezzatura casa</small></label>
                        </div>
                    </div>
                    <div class="intake-row-2">
                        <div class="intake-field-group">
                            <label class="intake-label">Profilo Forza Stimato</label>
                            <div class="intake-cards-grid cols-3">
                                <label class="intake-option-card compact ${saved.strengthProfile==='Low'?'selected':''}"><input type="radio" name="strength_profile" value="Low" ${saved.strengthProfile==='Low'?'checked':''}><strong>Bassa</strong><small>Focus tecnica</small></label>
                                <label class="intake-option-card compact ${(saved.strengthProfile==='Medium'||!saved.strengthProfile)?'selected':''}"><input type="radio" name="strength_profile" value="Medium" ${(saved.strengthProfile==='Medium'||!saved.strengthProfile)?'checked':''}><strong>Media</strong><small>Bilanciata</small></label>
                                <label class="intake-option-card compact ${saved.strengthProfile==='High'?'selected':''}"><input type="radio" name="strength_profile" value="High" ${saved.strengthProfile==='High'?'checked':''}><strong>Alta</strong><small>&gt; 80% 1RM</small></label>
                            </div>
                        </div>
                        <div class="intake-field-group">
                            <label class="intake-label">Condizionamento Cardio</label>
                            <div class="intake-cards-grid cols-4">
                                ${[['None','❌','Nessuno'],['Low','🚶','Leggero'],['Moderate','🏃','Moderato'],['High','⚡','HIIT']].map(([v,ic,la])=>`<label class="intake-option-card compact ${(saved.conditioning||'Moderate')===v?'selected':''}"><input type="radio" name="conditioning" value="${v}" ${(saved.conditioning||'Moderate')===v?'checked':''}><span>${ic}</span><small>${la}</small></label>`).join('')}
                            </div>
                        </div>
                    </div>
                </section>

                <!-- STEP 3: Salute -->
                <section class="intake-step-panel" id="step-3">
                    <div class="intake-step-header">
                        <span class="step-emoji">🩺</span>
                        <div><h3>Stato di Salute</h3><p>Seleziona eventuali limitazioni fisiche. L'IA adatterà automaticamente esercizi e fasi.</p></div>
                    </div>
                    <div class="intake-health-notice">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span>Queste informazioni sono usate solo per adattare il programma. Se hai dubbi, consulta il tuo medico.</span>
                    </div>
                    <div class="intake-field-group">
                        <label class="intake-label">Limitazioni fisiche o patologie <span class="label-opt">(opzionale — seleziona quelle che ti riguardano)</span></label>
                        
                        <!-- IMPACT SUMMARY WIDGET -->
                        <div id="impact-widget" class="impact-summary section" style="margin-top: 1rem; border: 1px solid var(--border); border-radius: 12px; background: rgba(15, 23, 42, 0.4); padding: 1.5rem;">
                            <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
                                <div class="impact-card">
                                    <div class="stat-value" id="stat-excluded">0</div>
                                    <div class="stat-label">Esercizi Esclusi</div>
                                </div>
                                <div class="impact-card">
                                    <div class="stat-value" id="stat-adapted">0</div>
                                    <div class="stat-label">Esercizi Adattati</div>
                                </div>
                                <div class="impact-card">
                                    <div class="stat-value" id="stat-risk">-</div>
                                    <div class="stat-label">Livello Rischio</div>
                                </div>
                            </div>
                        </div>

                        <!-- CLINICAL GRID -->
                        <div id="clinical-grid-container" style="margin-top: 1.5rem;"></div>
                    </div>
                    <div class="intake-field-group" style="margin-top:1.5rem">
                        <label class="intake-label">Intensità del dolore attuale</label>
                        <div class="pain-scale-wrap">
                            <input type="range" id="pain-scale" name="painScale" min="0" max="10" value="${saved.painScale||0}" class="pain-slider">
                            <div class="pain-labels"><span>0 – Nessun dolore</span><span id="pain-val">${saved.painScale||0}/10</span><span>10 – Dolore severo</span></div>
                        </div>
                    </div>
                </section>

                <!-- STEP 4: Obiettivi -->
                <section class="intake-step-panel" id="step-4">
                    <div class="intake-step-header">
                        <span class="step-emoji">🎯</span>
                        <div><h3>Qual è il tuo obiettivo?</h3><p>Scegli l'obiettivo principale e descrivilo con le tue parole per una scheda su misura.</p></div>
                    </div>
                    <div class="intake-field-group">
                        <label class="intake-label">Obiettivo Primario</label>
                        <div class="intake-cards-grid">
                            ${[['Hypertrophy','📈','Ipertrofia','Aumentare massa muscolare'],['Strength','💪','Forza','Alzare carichi massimali'],['Resistenza','🏃','Resistenza','Resistenza muscolare'],['Power','⚡','Potenza','Esplosività e sport'],['Definition','✂️','Definizione','Tonicità e composizione'],['Rehab','🩹','Recupero','Guarire e tornare normale']].map(([v,ic,la,desc])=>`<label class="intake-option-card ${(saved.goal||'Hypertrophy')===v?'selected':''}"><input type="radio" name="goal" value="${v}" ${(saved.goal||'Hypertrophy')===v?'checked':''}><span class="option-icon">${ic}</span><strong>${la}</strong><small>${desc}</small></label>`).join('')}
                        </div>
                    </div>
                    <div class="intake-field-group">
                        <label class="intake-label" for="p-objective">Descrivi il tuo obiettivo con parole tue <span class="label-opt">(opzionale ma consigliato)</span></label>
                        <textarea id="p-objective" name="patientObjective" rows="4" class="intake-textarea" placeholder="Es. &quot;Ho 45 anni, ho un'ernia al disco L4-L5 e voglio tornare a correre senza dolore. Per ora mi basta camminare 30 minuti senza fastidio alla gamba destra.&quot;">${saved.patientObjective||''}</textarea>
                        <small class="intake-hint">L'IA legge questo testo per adattare le fasi e la progressione.</small>
                    </div>
                    <div class="intake-field-group">
                        <label class="intake-label">Orizzonte temporale del programma</label>
                        <div class="intake-cards-grid cols-4">
                            ${[['4','4 settimane','Sprint rapido'],['8','8 settimane','Ciclo standard'],['12','12 settimane','Pianificazione completa'],['16','16 settimane','Prep. avanzata']].map(([v,la,desc])=>`<label class="intake-option-card compact ${(saved.weeks||'12')===v?'selected':''}"><input type="radio" name="weeks" value="${v}" ${(saved.weeks||'12')===v?'checked':'}><strong>${la}</strong><small>${desc}</small></label>`).join('')}
                        </div>
                    </div>
                </section>

                <!-- STEP 5: Stile di Vita -->
                <section class="intake-step-panel" id="step-5">
                    <div class="intake-step-header">
                        <span class="step-emoji">🌿</span>
                        <div><h3>Stile di Vita</h3><p>Questi fattori influenzano il recupero e il volume ottimale settimanale.</p></div>
                    </div>
                    <div class="intake-row-2">
                        <div class="intake-field-group">
                            <label class="intake-label">Qualità del sonno</label>
                            <div class="intake-cards-grid cols-3">
                                ${[['poor','😴','Scarso (&lt;6h)'],['ok','😊','Buono (6-7h)'],['great','🌟','Ottimo (7-9h)']].map(([v,ic,la])=>`<label class="intake-option-card compact ${(saved.sleep||'ok')===v?'selected':''}"><input type="radio" name="sleep" value="${v}" ${(saved.sleep||'ok')===v?'checked':''}><span>${ic}</span><small>${la}</small></label>`).join('')}
                            </div>
                        </div>
                        <div class="intake-field-group">
                            <label class="intake-label">Livello di Stress</label>
                            <div class="intake-cards-grid cols-3">
                                ${[['low','😌','Basso'],['moderate','😐','Moderato'],['high','😰','Alto']].map(([v,ic,la])=>`<label class="intake-option-card compact ${(saved.stress||'moderate')===v?'selected':''}"><input type="radio" name="stress" value="${v}" ${(saved.stress||'moderate')===v?'checked':''}><span>${ic}</span><small>${la}</small></label>`).join('')}
                            </div>
                        </div>
                    </div>
                    <div class="intake-row-2">
                        <div class="intake-field-group">
                            <label class="intake-label">Regime alimentare</label>
                            <div class="intake-cards-grid cols-3">
                                ${[['deficit','📉','Ipocalorica'],['maintenance','⚖️','Mantenimento'],['surplus','📈','Ipercalorica']].map(([v,ic,la])=>`<label class="intake-option-card compact ${(saved.nutrition||'maintenance')===v?'selected':''}"><input type="radio" name="nutrition" value="${v}" ${(saved.nutrition||'maintenance')===v?'checked':''}><span>${ic}</span><small>${la}</small></label>`).join('')}
                            </div>
                        </div>
                        <div class="intake-field-group">
                            <label class="intake-label">Attività extra-palestra</label>
                            <div class="intake-cards-grid cols-3">
                                ${[['sedentary','🪑','Sedentario'],['active','🚶','Attivo'],['very_active','🏃','Molto attivo']].map(([v,ic,la])=>`<label class="intake-option-card compact ${(saved.activity||'active')===v?'selected':''}"><input type="radio" name="activity" value="${v}" ${(saved.activity||'active')===v?'checked':''}><span>${ic}</span><small>${la}</small></label>`).join('')}
                            </div>
                        </div>
                    </div>
                    <!-- RIEPILOGO -->
                    <div class="intake-summary-box">
                        <h4>📋 Riepilogo del tuo profilo</h4>
                        <div id="summary-content" class="summary-grid"></div>
                    </div>
                </section>

                <!-- FOOTER NAV -->
                <div class="intake-nav-footer">
                    <button type="button" id="btn-back" class="intake-btn-back" style="visibility:hidden">← Indietro</button>
                    <span class="step-counter" id="step-counter">Step 1 di ${TOTAL_STEPS}</span>
                    <button type="button" id="btn-next" class="intake-btn-next">Avanti →</button>
                </div>
            </main>
        </div>

        <!-- GENERATION OVERLAY -->
        <div id="gen-overlay" class="gen-overlay hidden">
            <div class="gen-spinner-box">
                <div class="gen-spinner"></div>
                <p>L'IA sta costruendo il tuo programma...</p>
                <small id="gen-status-msg">Analisi del profilo clinico in corso...</small>
            </div>
        </div>

        <!-- RESULT CONTAINER -->
        <div id="prog-result" class="prog-result hidden"></div>
    `;

    // ── Inject scoped styles (idempotent) ──
    if (!document.getElementById('intake-wizard-styles')) {
        const s = document.createElement('style');
        s.id = 'intake-wizard-styles';
        s.textContent = `
            .intake-wrapper{display:flex;min-height:calc(100vh - 80px);}
            .intake-sidebar{width:260px;flex-shrink:0;background:linear-gradient(160deg,#0f172a 0%,#1e293b 100%);border-right:1px solid var(--border);padding:2.5rem 1.75rem;display:flex;flex-direction:column;}
            .intake-logo{font-size:2.5rem;margin-bottom:1rem;}
            .intake-sidebar-title{font-size:1.1rem;font-weight:700;color:var(--text-primary);line-height:1.3;margin-bottom:.75rem;}
            .intake-sidebar-sub{font-size:.8rem;color:var(--text-muted);line-height:1.5;margin-bottom:2rem;}
            .intake-steps-nav{display:flex;flex-direction:column;gap:.25rem;}
            .step-nav-item{display:flex;align-items:center;gap:.75rem;padding:.6rem .75rem;border-radius:8px;transition:background .2s;}
            .step-nav-item.active{background:rgba(16,185,129,.12);}
            .step-nav-item.done{background:rgba(16,185,129,.06);}
            .step-nav-dot{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;flex-shrink:0;background:var(--border);color:var(--text-muted);transition:all .3s;}
            .step-nav-item.active .step-nav-dot{background:var(--accent);color:#fff;}
            .step-nav-item.done .step-nav-dot{background:#10b981;color:#fff;}
            .step-nav-item span{font-size:.85rem;color:var(--text-muted);}
            .step-nav-item.active span,.step-nav-item.done span{color:var(--text-primary);font-weight:500;}
            .intake-main{flex:1;display:flex;flex-direction:column;overflow:hidden;background:var(--bg-dark);}
            .intake-progress-bar-wrap{height:4px;background:var(--border);flex-shrink:0;}
            .intake-progress-bar{height:100%;background:linear-gradient(90deg,#10b981,#06d6a0);transition:width .4s ease;}
            .intake-step-panel{display:none;flex:1;overflow-y:auto;padding:2.5rem;animation:fadeIn .3s ease;}
            .intake-step-panel.active{display:flex;flex-direction:column;gap:1.75rem;}
            .intake-step-header{display:flex;align-items:flex-start;gap:1rem;padding-bottom:1.25rem;border-bottom:1px solid var(--border);}
            .step-emoji{font-size:2rem;flex-shrink:0;margin-top:2px;}
            .intake-step-header h3{font-size:1.4rem;font-weight:700;color:var(--text-primary);margin:0 0 .3rem;}
            .intake-step-header p{font-size:.9rem;color:var(--text-muted);margin:0;}
            .intake-field-group{display:flex;flex-direction:column;gap:.75rem;}
            .intake-label{font-size:.9rem;font-weight:600;color:var(--text-primary);}
            .label-opt{font-weight:400;color:var(--text-muted);font-size:.82rem;margin-left:.35rem;}
            .intake-cards-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:.75rem;}
            .intake-cards-grid.cols-3{grid-template-columns:repeat(3,1fr);}
            .intake-cards-grid.cols-4{grid-template-columns:repeat(4,1fr);}
            .intake-cards-grid.cols-5{grid-template-columns:repeat(5,1fr);}
            .intake-option-card{display:flex;flex-direction:column;align-items:center;text-align:center;gap:.35rem;padding:1rem .75rem;border:2px solid var(--border);border-radius:12px;cursor:pointer;transition:all .2s;background:rgba(255,255,255,.02);position:relative;}
            .intake-option-card input{position:absolute;opacity:0;pointer-events:none;}
            .intake-option-card:hover{border-color:rgba(16,185,129,.4);background:rgba(16,185,129,.04);}
            .intake-option-card.selected{border-color:var(--accent);background:rgba(16,185,129,.1);box-shadow:0 0 0 1px var(--accent);}
            .intake-option-card.compact{padding:.75rem .5rem;gap:.25rem;}
            .option-icon{font-size:1.6rem;}
            .intake-option-card strong{font-size:.85rem;color:var(--text-primary);}
            .intake-option-card small{font-size:.75rem;color:var(--text-muted);line-height:1.3;}
            .day-num{font-size:1.6rem;font-weight:800;color:var(--accent);}
            .intake-row-2{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;}
            .intake-health-notice{display:flex;align-items:center;gap:.6rem;padding:.75rem 1rem;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.25);border-radius:8px;font-size:.83rem;color:#f59e0b;}
            .pain-scale-wrap{display:flex;flex-direction:column;gap:.5rem;}
            .pain-slider{width:100%;accent-color:var(--accent);height:6px;}
            .pain-labels{display:flex;justify-content:space-between;font-size:.8rem;color:var(--text-muted);}
            .intake-textarea{width:100%;padding:1rem;border-radius:10px;border:1px solid var(--border);background:rgba(0,0,0,.2);color:var(--text-primary);font-family:inherit;font-size:.9rem;line-height:1.6;resize:vertical;transition:border-color .2s;box-sizing:border-box;}
            .intake-textarea:focus{border-color:var(--accent);outline:none;}
            .intake-hint{font-size:.8rem;color:var(--text-muted);}
            .intake-summary-box{background:rgba(16,185,129,.06);border:1px solid rgba(16,185,129,.2);border-radius:12px;padding:1.25rem;margin-top:.5rem;}
            .intake-summary-box h4{font-size:.9rem;color:var(--accent);margin:0 0 .75rem;}
            .summary-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.6rem;}
            .summary-item{display:flex;flex-direction:column;gap:.2rem;}
            .summary-item .s-label{font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);}
            .summary-item .s-value{font-size:.88rem;font-weight:600;color:var(--text-primary);}
            .intake-nav-footer{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 2.5rem;border-top:1px solid var(--border);background:rgba(0,0,0,.1);flex-shrink:0;}
            .intake-btn-back{padding:.65rem 1.5rem;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text-muted);font-size:.9rem;cursor:pointer;transition:all .2s;}
            .intake-btn-back:hover{background:rgba(255,255,255,.05);color:var(--text-primary);}
            .step-counter{font-size:.82rem;color:var(--text-muted);}
            .intake-btn-next{padding:.7rem 2rem;border:none;border-radius:8px;background:var(--accent);color:#fff;font-size:.95rem;font-weight:600;cursor:pointer;transition:all .2s;}
            .intake-btn-next:hover{background:#059669;transform:translateY(-1px);}
            .intake-btn-next.generate{background:linear-gradient(135deg,#10b981,#6366f1);}
            .gen-overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);display:flex;align-items:center;justify-content:center;z-index:999;backdrop-filter:blur(6px);}
            .gen-overlay.hidden{display:none;}
            .gen-spinner-box{text-align:center;background:var(--surface);padding:3rem;border-radius:16px;border:1px solid var(--border);max-width:320px;}
            .gen-spinner{width:56px;height:56px;border:4px solid rgba(255,255,255,.1);border-top-color:var(--accent);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 1.25rem;}
            .gen-spinner-box p{font-weight:600;color:var(--text-primary);margin:0 0 .5rem;}
            .gen-spinner-box small{color:var(--text-muted);font-size:.82rem;}
            @keyframes spin{to{transform:rotate(360deg);}}
            @media(max-width:768px){
                .intake-wrapper{flex-direction:column;}
                .intake-sidebar{width:100%;padding:1.25rem 1.5rem;}
                .intake-steps-nav{flex-direction:row;flex-wrap:wrap;gap:.5rem;}
                .intake-step-panel{padding:1.25rem;}
                .intake-row-2{grid-template-columns:1fr;}
                .intake-cards-grid.cols-4,.intake-cards-grid.cols-5{grid-template-columns:repeat(2,1fr);}
                .intake-nav-footer{padding:1rem 1.25rem;}
            }
        `;
        document.head.appendChild(s);
    }

    // ── Collect current form values ──
    function collectData() {
        const get = name => { const el = container.querySelector(`[name="${name}"]:checked`); return el ? el.value : null; };
        return {
            patientType: get('patientType') || 'Atleta',
            level: get('level') || 'Intermediate',
            days: parseInt(get('days') || 3),
            equipment: get('equipment') || 'Full',
            strength_profile: get('strength_profile') || 'Medium',
            conditioning: get('conditioning') || 'Moderate',
            injuries: window.ClinicalManager ? window.ClinicalManager.selectedConditions : [],
            painScale: parseInt(container.querySelector('#pain-scale')?.value || 0),
            goal: get('goal') || 'Hypertrophy',
            weeks: get('weeks') || '12',
            patientObjective: container.querySelector('[name="patientObjective"]')?.value || '',
            sleep: get('sleep') || 'ok',
            stress: get('stress') || 'moderate',
            nutrition: get('nutrition') || 'maintenance',
            activity: get('activity') || 'active',
        };
    }

    // ── Render summary on step 5 ──
    function renderSummary() {
        const d = collectData();
        const el = container.querySelector('#summary-content');
        if (!el) return;
        const items = [['Profilo',d.patientType],['Esperienza',d.level],['Giorni/sett.',d.days],['Attrezzatura',d.equipment],['Obiettivo',d.goal],['Settimane',d.weeks],['Patologie',d.injuries.length?`${d.injuries.length} selezionate`:'Nessuna'],['Sonno',d.sleep],['Stress',d.stress],['Cardio',d.conditioning]];
        el.innerHTML = items.map(([l,v])=>`<div class="summary-item"><span class="s-label">${l}</span><span class="s-value">${v}</span></div>`).join('');
    }

    // ── Update UI on step change ──
    function updateUI() {
        container.querySelector('#intake-pbar').style.width = (currentStep / TOTAL_STEPS * 100) + '%';
        container.querySelector('#step-counter').textContent = `Step ${currentStep} di ${TOTAL_STEPS}`;
        container.querySelectorAll('.intake-step-panel').forEach((p,i) => p.classList.toggle('active', i+1 === currentStep));
        container.querySelectorAll('.step-nav-item').forEach((item,i) => {
            item.classList.remove('active','done');
            if (i+1 === currentStep) item.classList.add('active');
            else if (i+1 < currentStep) item.classList.add('done');
        });
        const btnBack = container.querySelector('#btn-back');
        btnBack.style.visibility = currentStep === 1 ? 'hidden' : 'visible';
        const btnNext = container.querySelector('#btn-next');
        if (currentStep === TOTAL_STEPS) { btnNext.textContent = '✨ Genera Programma'; btnNext.classList.add('generate'); }
        else { btnNext.textContent = 'Avanti →'; btnNext.classList.remove('generate'); }
        if (currentStep === TOTAL_STEPS) renderSummary();
    }

    // ── Initialize Clinical Manager inside Wizard ──
    if (window.ClinicalManager) {
        window.ClinicalManager.init('clinical-grid-container', saved.injuries || []);
        // Force update category counters for all preloaded categories
        const conditions = window.App.getConditions();
        const categories = [...new Set(conditions.map(c => c.category))];
        categories.forEach(cat => window.ClinicalManager.updateCategoryCounter(cat));
    }

    // ── Card click handler (radio) ──
    container.querySelectorAll('.intake-option-card').forEach(card => {
        card.addEventListener('click', () => {
            const input = card.querySelector('input[type="radio"]');
            if (input) {
                container.querySelectorAll(`[name="${input.name}"]`).forEach(el => el.closest('.intake-option-card')?.classList.remove('selected'));
                input.checked = true;
                card.classList.add('selected');
            }
        });
    });

    container.querySelectorAll('.path-chip').forEach(chip => {
        chip.addEventListener('click', () => {
            chip.classList.toggle('selected');
            const input = chip.querySelector('input[type="checkbox"]');
            if (input) input.checked = chip.classList.contains('selected');
        });
    });

    // ── Pain slider ──
    const painSlider = container.querySelector('#pain-scale');
    const painVal = container.querySelector('#pain-val');
    if (painSlider && painVal) painSlider.addEventListener('input', () => { painVal.textContent = painSlider.value + '/10'; });

    // ── Navigation buttons ──
    container.querySelector('#btn-back').addEventListener('click', () => { if (currentStep > 1) { currentStep--; updateUI(); } });

    container.querySelector('#btn-next').addEventListener('click', async () => {
        if (currentStep < TOTAL_STEPS) { currentStep++; updateUI(); }
        else { await generateProgram(); }
    });

    // ── Generate ──
    async function generateProgram() {
        const d = collectData();
        const isRehab = d.goal === 'Rehab';
        const params = {
            days: d.days,
            goal: isRehab ? 'Resistenza' : d.goal,
            level: d.level,
            equipment: d.equipment,
            conditioning: d.conditioning,
            strengthProfile: d.strength_profile,
            injuries: d.injuries,
            patientObjective: d.patientObjective + (isRehab ? ' recupero guarire riabilitazione' : ''),
            patientType: d.patientType,
            weeks: d.weeks,
            sleep: d.sleep,
            stress: d.stress,
            nutrition: d.nutrition,
            activity: d.activity,
            painScale: d.painScale
        };
        localStorage.setItem('t7_prog_params', JSON.stringify({ patientType:d.patientType,level:d.level,days:d.days,equipment:d.equipment,conditioning:d.conditioning,strengthProfile:d.strength_profile,goal:d.goal,weeks:d.weeks,patientObjective:d.patientObjective,sleep:d.sleep,stress:d.stress,nutrition:d.nutrition,activity:d.activity,injuries:d.injuries }));

        const overlay = container.querySelector('#gen-overlay');
        overlay.classList.remove('hidden');
        const msgs = ['Analisi del profilo clinico...','Selezione esercizi in base alle patologie...','Costruzione della progressione...','Applicazione vincoli di sicurezza...','Finalizzazione del programma...'];
        let mi = 0;
        const msgEl = container.querySelector('#gen-status-msg');
        const msgInt = setInterval(() => { mi=(mi+1)%msgs.length; if(msgEl) msgEl.textContent=msgs[mi]; }, 900);

        try {
            await new Promise(r => setTimeout(r, 2000));
            if (!window.AI || !window.AI.generateFullProgram) throw new Error('Modulo AI non caricato. Ricarica la pagina.');
            const program = window.AI.generateFullProgram(params);
            clearInterval(msgInt);
            overlay.classList.add('hidden');
            const resultEl = container.querySelector('#prog-result');
            resultEl.classList.remove('hidden');
            container.querySelector('.intake-wrapper').style.display = 'none';
            window.App.renderProgramResult('prog-result', program);
            resultEl.scrollIntoView({ behavior: 'smooth' });
        } catch (err) {
            clearInterval(msgInt);
            overlay.classList.add('hidden');
            console.error('Gen Error:', err);
            const resultEl = container.querySelector('#prog-result');
            resultEl.innerHTML = `<div style="max-width:600px;margin:2rem auto;padding:1.5rem;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);border-radius:12px;"><h4 style="color:#ef4444;margin:0 0 .5rem">❌ Errore generazione</h4><p style="color:var(--text-secondary);margin:0 0 1rem">${err.message}</p><button onclick="location.reload()" style="padding:.5rem 1.25rem;background:var(--accent);color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:600">Riprova</button></div>`;
            resultEl.classList.remove('hidden');
        }
    }

    // ── Init ──
    updateUI();
};


// RENDER: FULL PROGRAM RESULT (v3 - Detailed View)
window.App.renderProgramResult = function (containerId, result) {
    const container = document.getElementById(containerId);
    if (!container) return;

    container.classList.remove('hidden');

    const riskColor = result.meta.riskLevel === 'HIGH' ? '#ef4444' :
        result.meta.riskLevel === 'MEDIUM' ? '#f59e0b' : '#10b981';

    // 1. GENERATE PROGRESSION TABLE HTML
    let progressionHtml = `
    <div class="progression-section">
        <h3>📈 Timeline 12 Settimane</h3>
        <div class="table-responsive">
            <table class="prog-table">
                <thead>
                    <tr>
                        <th>Settimane</th>
                        <th>Fase</th>
                        <th>Volume</th>
                        <th>Intensità</th>
                        <th>Focus Clinico / Metodologico</th>
                    </tr>
                </thead>
                <tbody>
                    ${result.progression.map(p => `
                        <tr>
                            <td><span class="badge-week">${p.weeks}</span></td>
                            <td><strong>${p.phase}</strong></td>
                            <td>${p.vol}</td>
                            <td>${p.int}</td>
                            <td>${p.note}</td>
                        </tr>
                    `).join('')}
                </tbody>
            </table>
        </div>
    </div>`;

    // 2. BUILD THE DYNAMIC ACTIVE PHASE RENDERER
    function getPhaseContentHtml(phase) {
        let scheduleHtml = '';
        phase.schedule.forEach((day, index) => {
            if (day.isRest) {
                scheduleHtml += `
                <div class="day-card rest-day">
                    <div class="day-header">
                        <h4>${day.name}</h4>
                        <span class="badge rest">RECUPERO 💤</span>
                    </div>
                    <div class="day-body">Recupero Attivo (Stretching leggero, Mobilità, Rilascio Miofasciale)</div>
                </div>`;
            } else {
                // Segregate exercises
                const warmups = day.exercises.filter(e => e.isWarmup);
                const workout = day.exercises.filter(e => !e.isWarmup && !e.isCardio);
                const cardio = day.exercises.filter(e => e.isCardio);

                scheduleHtml += `
                <div class="day-card work-day">
                    <div class="day-header">
                        <div class="dh-left">
                            <h4>${day.name}</h4>
                            <span class="day-focus">${Array.isArray(day.focus) ? day.focus.join(' • ') : day.focus}</span>
                        </div>
                        <div class="dh-right">
                            <span class="time-badge">⏱️ ~${day.estDuration} min</span>
                        </div>
                    </div>

                    <div class="day-content">
                        <!-- WARMUP -->
                        ${warmups.length > 0 ? `
                        <div class="section-block warmup-block">
                            <h5>🔥 Warm-Up (Riscaldamento)</h5>
                            ${warmups.map(ex => `
                                <div class="ex-row warmup-row">
                                    <span class="ex-name">${ex.name}</span>
                                    <span class="ex-specs">${ex.specs.sets} x ${ex.specs.reps}</span>
                                </div>
                            `).join('')}
                        </div>` : ''}

                        <!-- MAIN WORKOUT -->
                        <div class="section-block main-block">
                            <h5>🏋️ Allenamento Principale</h5>
                            ${workout.map((ex, i) => `
                                <div class="exercise-card ${ex.isadapted ? 'is-adapted' : 'is-ok'}">
                                    <div class="ec-header">
                                        <span class="ec-num">${i + 1}</span>
                                        <span class="ec-name">${ex.name} ${ex.isadapted ? '⚠️' : ''}</span>
                                    </div>
                                    <div class="ec-specs">
                                        <div class="spec-item"><span class="lbl">Serie</span><span class="val">${ex.specs.sets}</span></div>
                                        <div class="spec-item"><span class="lbl">Reps</span><span class="val">${ex.specs.reps}</span></div>
                                        <div class="spec-item"><span class="lbl">Rest</span><span class="val">${ex.specs.rest}</span></div>
                                        <div class="spec-item"><span class="lbl">RPE</span><span class="val">${ex.specs.rpe}</span></div>
                                        <div class="spec-item"><span class="lbl">Tempo</span><span class="val">${ex.specs.tempo}</span></div>
                                        <div class="spec-item"><span class="lbl">Carico</span><span class="val highlight">${ex.specs.load}</span></div>
                                    </div>
                                    ${ex.note ? `<div class="ec-note">${ex.note}</div>` : ''}
                                </div>
                            `).join('')}
                        </div>

                        <!-- CARDIO / DECOOLDOWN -->
                        ${cardio.length > 0 ? `
                        <div class="section-block cardio-block">
                            <h5>🫁 Defaticamento & Cardio</h5>
                            ${cardio.map(c => `
                                <div class="ex-row cardio-row">
                                    <span class="c-name">${c.name}</span>
                                    <span class="c-specs">${c.specs.sets} • ${c.specs.reps}</span>
                                </div>
                            `).join('')}
                        </div>` : ''}
                    </div>
                </div>`;
            }
        });

        const clinicalSpecsHtml = result.meta.patientType === 'Clinico' ? `
            <div class="phase-clinical-specs-banner">
                <div class="spec-bubble">
                    <span class="lbl">RPE Limite (Cap)</span>
                    <span class="val">RPE ${phase.rpeCap || 6}</span>
                </div>
                <div class="spec-bubble">
                    <span class="lbl">ROM Ginocchio Consentito</span>
                    <span class="val">${phase.kneeROM || 90}° flessione max</span>
                </div>
                <div class="spec-bubble ${phase.isDeload ? 'deload-status' : 'work-status'}">
                    <span class="lbl">Stato Fase</span>
                    <span class="val">${phase.isDeload ? 'Scarico Clinico 🌿' : 'Fase Attiva'}</span>
                </div>
            </div>` : '';

        return `
            <div class="phase-objective-card">
                <h4>Obiettivo della Fase</h4>
                <p>${phase.objective}</p>
                <div class="phase-meta-info">
                    <span><strong>Volume:</strong> ${result.progression[phase.id - 1].vol}</span>
                    <span><strong>Intensità:</strong> ${result.progression[phase.id - 1].int}</span>
                    <span><strong>Focus:</strong> ${phase.focus}</span>
                </div>
            </div>
            ${clinicalSpecsHtml}
            <div class="schedule-grid-v3">${scheduleHtml}</div>`;
    }

    // 3. MAIN CONTAINER INNER HTML
    container.innerHTML = `
        <div class="program-result-v3 animate-fade-in">
            <div class="report-header-v3">
                <div class="rh-left">
                    <span class="rh-kicker">REPORT DI PROGRAMMAZIONE COMPLETO</span>
                    <h2>Scheda di Preparazione Atletica Personale</h2>
                    <div class="rh-meta">
                        <span class="tag patient-type">${result.meta.patientType === 'Clinico' ? 'Paziente Clinico' : 'Atleta / Fitness'}</span>
                        <span class="tag split">${result.meta.splitName}</span>
                        <span class="tag goal">${result.meta.goal}</span>
                        <span class="tag level">${result.meta.level}</span>
                    </div>
                </div>
                <div class="rh-right">
                    <div class="risk-indicator" style="--risk-color: ${riskColor}">
                        <div class="risk-lbl">Profilo di Rischio</div>
                        <div class="risk-val">${result.meta.riskLevel}</div>
                    </div>
                </div>
            </div>

            <!-- CLINICAL WARNING NOTES -->
            ${result.notes.length > 0 ? `
            <div class="clinical-alerts-card">
                <h4>⚠️ Prescrizioni di Sicurezza Clinica</h4>
                <ul>
                    ${result.notes.map(note => `<li>${note}</li>`).join('')}
                </ul>
            </div>` : ''}

            <!-- 12 WEEK TIMELINE TABLE -->
            ${progressionHtml}

            <!-- PHASE SELECTOR TABS -->
            <div class="phase-selector-section">
                <h3>Esplora le 6 Fasi del Programma</h3>
                <div class="phase-tabs-v3">
                    ${result.phases.map((p, idx) => `
                        <button class="phase-tab-btn ${idx === 0 ? 'active' : ''} ${p.isDeload ? 'is-deload-tab' : ''}" data-phase-id="${p.id}">
                            <span class="tab-weeks">${p.weeks}</span>
                            <span class="tab-name">${p.name.split(':')[0]}</span>
                        </button>
                    `).join('')}
                </div>
            </div>

            <!-- ACTIVE PHASE CONTENT CONTAINER -->
            <div id="active-phase-container" class="active-phase-schedule-container">
                ${getPhaseContentHtml(result.phases[0])}
            </div>

            <!-- ACTIONS (Export PDF / Close) -->
            <div class="report-actions-v3">
                <button type="button" class="btn-pdf-export">📥 Esporta Report PDF</button>
                <button type="button" class="btn-close-report" onclick="location.reload()">Chiudi Report</button>
            </div>
        </div>
    `;

    // 4. ATTACH TAB CLICKS
    container.querySelectorAll('.phase-tab-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const targetBtn = e.currentTarget;
            container.querySelectorAll('.phase-tab-btn').forEach(b => b.classList.remove('active'));
            targetBtn.classList.add('active');

            const phaseId = parseInt(targetBtn.dataset.phaseId);
            const phaseData = result.phases.find(p => p.id === phaseId);
            
            const activePhaseContainer = container.querySelector('#active-phase-container');
            if (activePhaseContainer && phaseData) {
                activePhaseContainer.innerHTML = getPhaseContentHtml(phaseData);
            }
        });
    });

    // 5. PDF EXPORT (PRINT DIALOG FALLBACK WITH MODERN CSS OVERRIDES)
    container.querySelector('.btn-pdf-export').addEventListener('click', () => {
        window.print();
    });

    // 6. INJECT RESULT LAYOUT STYLES Dynamically
    if (!document.getElementById('result-view-styles')) {
        const style = document.createElement('style');
        style.id = 'result-view-styles';
        style.textContent = `
            .program-result-v3 { background: #0f172a; border: 1px solid var(--border); border-radius: 16px; padding: 2.5rem; max-width: 1000px; margin: 2rem auto; box-shadow: var(--shadow-lg); }
            .report-header-v3 { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 2rem; border-bottom: 1px solid var(--border); margin-bottom: 2rem; flex-wrap: wrap; gap: 1.5rem; }
            .rh-kicker { font-size: 0.75rem; text-transform: uppercase; color: var(--accent); letter-spacing: 0.1em; font-weight: 700; display: block; margin-bottom: 0.5rem; }
            .report-header-v3 h2 { font-size: 1.8rem; font-weight: 800; color: var(--text-primary); margin: 0 0 1rem; }
            .rh-meta { display: flex; gap: 0.5rem; flex-wrap: wrap; }
            .rh-meta .tag { background: rgba(255,255,255,0.05); color: var(--text-secondary); border: 1px solid var(--border); padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; text-transform: capitalize; }
            .rh-meta .tag.patient-type { background: rgba(59, 130, 246, 0.1); border-color: rgba(59, 130, 246, 0.2); color: #60a5fa; }
            
            .risk-indicator { border-left: 4px solid var(--risk-color); padding-left: 1rem; }
            .risk-indicator .risk-lbl { font-size: 0.75rem; text-transform: uppercase; color: var(--text-secondary); letter-spacing: 0.05em; }
            .risk-indicator .risk-val { font-size: 1.6rem; font-weight: 800; color: var(--risk-color); margin-top: 0.25rem; }

            .clinical-alerts-card { background: rgba(239, 68, 68, 0.04); border: 1px solid rgba(239, 68, 68, 0.15); border-left: 4px solid #ef4444; border-radius: 4px 12px 12px 4px; padding: 1.25rem 1.5rem; margin-bottom: 2.5rem; }
            .clinical-alerts-card h4 { color: #ef4444; margin: 0 0 0.75rem; font-size: 1rem; font-weight: 700; }
            .clinical-alerts-card ul { margin: 0; padding-left: 1.25rem; }
            .clinical-alerts-card li { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin-bottom: 0.4rem; }
            .clinical-alerts-card li::marker { color: #ef4444; }

            .progression-section { margin-bottom: 3rem; }
            .progression-section h3 { font-size: 1.3rem; margin-bottom: 1.25rem; color: var(--text-primary); }
            .table-responsive { overflow-x: auto; width: 100%; border-radius: 12px; border: 1px solid var(--border); background: rgba(0,0,0,0.1); }
            .prog-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.92rem; }
            .prog-table th { padding: 1rem 1.25rem; background: rgba(255,255,255,0.02); color: var(--text-secondary); border-bottom: 1px solid var(--border); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
            .prog-table td { padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); color: var(--text-primary); line-height: 1.5; }
            .prog-table tr:last-child td { border-bottom: none; }
            .badge-week { background: rgba(16, 185, 129, 0.1); color: #10b981; padding: 4px 8px; border-radius: 6px; font-weight: 700; font-size: 0.8rem; border: 1px solid rgba(16, 185, 129, 0.2); }

            .phase-selector-section { margin-bottom: 2rem; border-top: 1px solid var(--border); padding-top: 2rem; }
            .phase-selector-section h3 { font-size: 1.3rem; margin-bottom: 1.25rem; color: var(--text-primary); }
            .phase-tabs-v3 { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); }
            .phase-tab-btn { flex: 1; min-width: 140px; background: transparent; border: 1px solid var(--border); border-bottom: none; padding: 0.75rem 1rem; border-radius: 8px 8px 0 0; text-align: left; display: flex; flex-direction: column; gap: 0.25rem; cursor: pointer; transition: all 0.2s; color: var(--text-muted); position: relative; top: 1px; }
            .phase-tab-btn:hover { color: var(--text-primary); background: rgba(255, 255, 255, 0.05); }
            .phase-tab-btn.active { color: #fff; background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%); box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25); }
            .phase-tab-btn.is-deload-tab.active { background: linear-gradient(135deg, #10b981 0%, #059669 100%); box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25); }
            .phase-tab-btn .tab-weeks { font-size: 0.75rem; opacity: 0.85; text-transform: uppercase; font-weight: 500; letter-spacing: 0.05em; }
            .phase-tab-btn .tab-name { font-size: 0.95rem; font-weight: 600; }

            .active-phase-schedule-container { min-height: 300px; margin-bottom: 2.5rem; }
            .phase-objective-card { background: rgba(30, 41, 59, 0.4); border: 1px solid var(--border); border-left: 4px solid var(--primary); padding: 1.5rem; border-radius: 4px 12px 12px 4px; margin-bottom: 1.5rem; }
            .phase-objective-card h4 { margin-bottom: 0.5rem; font-size: 1.2rem; color: var(--text-primary); }
            .phase-objective-card p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1rem; }
            .phase-meta-info { display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: 0.85rem; color: var(--text-secondary); border-top: 1px solid rgba(255,255,255,0.05); padding-top: 0.75rem; }
            
            .phase-clinical-specs-banner { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
            .spec-bubble { background: rgba(15, 23, 42, 0.4); border: 1px solid var(--border); padding: 1rem; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
            .spec-bubble .lbl { font-size: 0.75rem; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 0.25rem; letter-spacing: 0.05em; }
            .spec-bubble .val { font-size: 1.1rem; font-weight: 700; color: var(--text-primary); }
            .spec-bubble.deload-status .val { color: #10b981; }
            .spec-bubble.work-status .val { color: var(--primary); }

            .schedule-grid-v3 { display: grid; gap: 2rem; }
            .day-card { border: 1px solid var(--border); border-radius: 12px; background: rgba(15, 23, 42, 0.4); overflow: hidden; box-shadow: var(--shadow-sm); }
            .day-card.rest-day { border-color: rgba(16, 185, 129, 0.2); background: rgba(16, 185, 129, 0.02); }
            .day-card.rest-day .day-header { border-bottom-color: rgba(16, 185, 129, 0.1); }
            .day-card.rest-day .day-body { padding: 1.5rem; color: var(--text-secondary); font-size: 0.95rem; }
            .day-header { background: rgba(255,255,255,0.02); padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); }
            .day-header h4 { font-size: 1.15rem; }
            .day-focus { font-size: 0.8rem; color: var(--primary); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-top: 0.25rem; font-weight: 600; }
            .day-card.rest-day .day-focus { color: #10b981; }
            .badge.rest { background: rgba(16, 185, 129, 0.1); color: #10b981; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; border: 1px solid rgba(16, 185, 129, 0.2); }
            .time-badge { font-size: 0.85rem; color: var(--text-secondary); background: rgba(255,255,255,0.05); padding: 4px 8px; border-radius: 6px; }

            .day-content { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
            .section-block h5 { font-size: 0.75rem; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 0.75rem; letter-spacing: 0.1em; font-weight: 700; border-left: 2px solid var(--primary); padding-left: 0.5rem; }
            .warmup-block h5 { border-left-color: #f59e0b; }
            .cardio-block h5 { border-left-color: #10b981; }
            
            .warmup-row, .cardio-row { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0.75rem; font-size: 0.95rem; color: var(--text-secondary); background: rgba(255,255,255,0.02); border-radius: 6px; margin-bottom: 0.4rem; border: 1px solid rgba(255,255,255,0.02); }
            .warmup-row .ex-name, .cardio-row .c-name { font-weight: 500; color: var(--text-primary); }
            .warmup-row .ex-specs, .cardio-row .c-specs { font-weight: 600; color: var(--text-secondary); font-size: 0.9rem; }
            
            .exercise-card { background: rgba(0,0,0,0.15); padding: 1.25rem; border-radius: 10px; margin-bottom: 0.75rem; border: 1px solid var(--border); border-left: 4px solid var(--primary); transition: transform 0.2s ease; }
            .exercise-card:hover { transform: translateX(4px); }
            .exercise-card.is-adapted { border-left-color: var(--warning); background: rgba(245, 158, 11, 0.03); border-color: rgba(245, 158, 11, 0.15); }
            
            .ec-header { display: flex; align-items: center; margin-bottom: 1rem; }
            .ec-num { background: rgba(255,255,255,0.08); width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 0.85rem; margin-right: 0.75rem; font-weight: 600; color: var(--text-primary); }
            .ec-name { font-weight: 600; font-size: 1.05rem; color: var(--text-primary); }
            
            .ec-specs { display: grid; grid-template-columns: repeat(auto-fit, minmax(80px, 1fr)); gap: 0.75rem; }
            .spec-item { display: flex; flex-direction: column; background: rgba(255,255,255,0.02); padding: 0.5rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.02); text-align: center; }
            .spec-item .lbl { font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 0.25rem; letter-spacing: 0.03em; }
            .spec-item .val { font-size: 0.95rem; font-weight: 600; color: var(--text-primary); }
            .spec-item .val.highlight { color: var(--accent); }
            
            .ec-note { margin-top: 0.75rem; font-size: 0.85rem; color: var(--warning); font-style: italic; background: rgba(245, 158, 11, 0.05); padding: 0.5rem 0.75rem; border-radius: 6px; border: 1px solid rgba(245, 158, 11, 0.1); display: flex; align-items: center; gap: 0.35rem; }
            
            .animate-fade-in { animation: fadeIn 0.25s ease-out forwards; }
            @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

            .report-actions-v3 { display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
            .btn-pdf-export, .btn-close-report { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600; font-size: 0.95rem; cursor: pointer; transition: all 0.2s; border: none; }
            .btn-pdf-export { background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%); color: #fff; box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.25); }
            .btn-pdf-export:hover { transform: translateY(-1px); box-shadow: 0 6px 12px -2px rgba(59, 130, 246, 0.3); }
            .btn-close-report { background: rgba(255,255,255,0.05); color: var(--text-secondary); border: 1px solid var(--border); }
            .btn-close-report:hover { background: rgba(255,255,255,0.08); color: var(--text-primary); }

            /* Print layout overrides */
            @media print {
                body { background: white !important; color: black !important; }
                .app-header, .programming-container, .phase-selector-section, .report-actions-v3, #generator-form { display: none !important; }
                .program-result-v3 { background: white !important; padding: 0 !important; border: none !important; box-shadow: none !important; margin: 0 !important; }
                .report-header-v3 { border-bottom-color: #ddd !important; }
                .rh-meta .tag { background: none !important; border-color: #ccc !important; color: black !important; }
                .rh-meta .tag.patient-type { color: black !important; font-weight: bold; }
                .prog-table { border-color: #ccc !important; }
                .prog-table th { color: #333 !important; border-bottom-color: #ccc !important; }
                .prog-table td { color: black !important; border-bottom-color: #eee !important; }
                .badge-week { background: none !important; border-color: #bbb !important; color: black !important; }
                .day-card { border-color: #ccc !important; background: white !important; page-break-inside: avoid; margin-bottom: 2rem; }
                .day-header { border-bottom-color: #ccc !important; background: none !important; }
                .day-focus, .time-badge, .badge.rest { color: black !important; background: none !important; border-color: #ccc !important; }
                .exercise-card { background: white !important; border-color: #ccc !important; border-left-color: black !important; }
                .exercise-card.is-adapted { border-left-color: #f59e0b !important; }
                .spec-item { background: white !important; border-color: #eee !important; }
                .spec-item .lbl { color: #555 !important; }
                .spec-item .val { color: black !important; }
                .warmup-row, .cardio-row { background: white !important; border-color: #eee !important; color: black !important; }
                .warmup-row .ex-specs, .cardio-row .c-specs { color: black !important; }
                .ec-note { color: #c2410c !important; border-color: #fed7aa !important; background: #fff7ed !important; }
                .phase-objective-card { background: white !important; border-color: #ccc !important; border-left-color: black !important; }
                .phase-objective-card h4, .phase-objective-card p, .phase-meta-info { color: black !important; }
                .phase-clinical-specs-banner { display: flex !important; gap: 1rem !important; }
                .spec-bubble { background: white !important; border-color: #ccc !important; }
                .spec-bubble .lbl { color: #555 !important; }
                .spec-bubble .val { color: black !important; }
            }
        `;
        document.head.appendChild(style);
    }

    // Scroll
    container.scrollIntoView({ behavior: 'smooth' });
};

// Helper Icons
function getIcon(key) {
    const icons = {
        'neck': '🦒', 'spine': '🦴', 'spine_curved': '〰️', 'disc': '💿',
        'shoulder': '💪', 'knee': '🦵', 'ligament': '🩹', 'heart': '❤️',
        'body': '🧘', 'hand': '✋', 'arm': '🦾', 'drop': '🩸', 'lungs': '🫁', 'foot': '🦶', 'hip': '🦴'
    };
    return icons[key] || '🩺';
}

window.App.renderFilters = function (containerId, onFilterChange) {
    const container = document.getElementById(containerId);
    if (!container) return;

    // Generate Options Dynamically from NEW Taxonomy
    let muscleOptions = '<option value="all">Tutti i Muscoli</option>';
    const taxonomy = window.App.MUSCLE_TAXONOMY;

    if (taxonomy) {
        Object.keys(taxonomy).forEach(key => {
            const group = taxonomy[key];
            muscleOptions += `<optgroup label="${group.label}">`;
            group.muscles.forEach(muscle => {
                muscleOptions += `<option value="${muscle}">${muscle}</option>`;
            });
            muscleOptions += `</optgroup>`;
        });
    } else {
        // Fallback if taxonomy not loaded
        muscleOptions += `
            <option value="Pettorale Maggiore">Pettorale Maggiore</option>
            <option value="Gran Dorsale">Gran Dorsale</option>
            <option value="Quadricipite Femorale">Quadricipite Femorale</option>
        `;
    }

    container.innerHTML = `
        <div class="filter-bar">
            <div class="search-group">
                <span class="search-icon">🔍</span>
                <input type="text" id="filter-search" placeholder="Cerca esercizi (es. Squat, Panca)..." />
            </div>
            
            <div class="select-group">
                <select id="filter-muscle">
                    ${muscleOptions}
                </select>
 
                <select id="filter-level">
                    <option value="all">Tutti i Livelli</option>
                    <option value="Principiante">Principiante</option>
                    <option value="Intermedio">Intermedio</option>
                    <option value="Avanzato">Avanzato</option>
                </select>
 
                <select id="filter-equipment">
                    <option value="all">Tutta l'Attrezzatura</option>
                    <option value="Bilanciere">Bilanciere</option>
                    <option value="Manubri">Manubri</option>
                    <option value="Corpo Libero">Corpo Libero</option>
                    <option value="Macchine">Macchine</option>
                    <option value="Cavi">Cavi</option>
                    <option value="Sbarra Trazioni">Sbarra / Trazioni</option>
                    <option value="Attrezzi">Altri Attrezzi</option>
                    <option value="Panca">Panca</option>
                </select>
 
                <select id="filter-quality">
                    <option value="all">Tutte le Qualità</option>
                    <option value="Forza">Forza</option>
                    <option value="Ipertrofia">Ipertrofia</option>
                    <option value="Potenza">Potenza</option>
                </select>
                
                <button id="btn-add-exercise" class="btn-primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;">+ Aggiungi</button>
            </div>
        </div>
    `;

    // Attach Listeners
    const inputs = container.querySelectorAll('input, select');
    inputs.forEach(input => {
        input.addEventListener('input', () => {
            triggerFilterChange();
        });
    });

    // Add Button Listener
    const btnAdd = container.querySelector('#btn-add-exercise');
    if (btnAdd) {
        btnAdd.addEventListener('click', () => {
            window.App.renderAddExerciseModal(onFilterChange);
        });
    }

    function triggerFilterChange() {
        const filters = {
            search: document.getElementById('filter-search').value,
            muscle: document.getElementById('filter-muscle').value,
            level: document.getElementById('filter-level').value,
            equipment: document.getElementById('filter-equipment').value,
            quality: document.getElementById('filter-quality').value
        };
        onFilterChange(filters);
    }
};

window.App.renderAddExerciseModal = function (onSuccessCallback) {
    // Generate Options Dynamically from NEW Taxonomy
    let muscleOptions = '';
    const taxonomy = window.App.MUSCLE_TAXONOMY;

    if (taxonomy) {
        Object.keys(taxonomy).forEach(key => {
            const group = taxonomy[key];
            muscleOptions += `<optgroup label="${group.label}">`;
            group.muscles.forEach(muscle => {
                muscleOptions += `<option value="${muscle}">${muscle}</option>`;
            });
            muscleOptions += `</optgroup>`;
        });
    } else {
        muscleOptions = `<option value="Pettorale Maggiore">Pettorale Maggiore</option>`; // Fallback
    }

    const content = `
        <div class="modal-form-container">
            <h3>Aggiungi Nuovo Esercizio</h3>
            <form id="add-exercise-form">
                <div class="form-group">
                    <label>Nome Esercizio *</label>
                    <input type="text" name="name" required placeholder="Es. Panca Piana">
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Gruppo Muscolare *</label>
                        <select name="primaryMuscle">
                           ${muscleOptions}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Livello *</label>
                        <select name="level">
                            <option value="Principiante">Principiante</option>
                            <option value="Intermedio">Intermedio</option>
                            <option value="Avanzato">Avanzato</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Attrezzatura</label>
                        <select name="equipment">
                            <option value="Bilanciere">Bilanciere</option>
                            <option value="Manubri">Manubri</option>
                            <option value="Macchine">Macchine</option>
                            <option value="Corpo Libero">Corpo Libero</option>
                            <option value="Cavi">Cavi</option>
                            <option value="Sbarra Trazioni">Sbarra Trazioni</option>
                            <option value="Attrezzi">Altri Attrezzi</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Tipo Movimento</label>
                        <select name="type">
                            <option value="Multiarticolare">Multiarticolare</option>
                            <option value="Isolamento">Isolamento</option>
                            <option value="Isometrico">Isometrico</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>Descrizione Breve</label>
                    <textarea name="description" rows="2" placeholder="Descrivi l'esercizio..."></textarea>
                </div>

                <button type="submit" class="btn-primary" style="width: 100%;">Salva Esercizio</button>
            </form>
        </div>
    `;
    window.App.openModal(content);

    // Handle Submit
    setTimeout(() => {
        const form = document.getElementById('add-exercise-form');
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const formData = new FormData(form);

            // Determine Category from Taxonomy based on selected Primary Muscle
            let category = 'Isolamento'; // Default
            if (taxonomy) {
                const selectedMuscle = formData.get('primaryMuscle');
                for (const [catKey, group] of Object.entries(taxonomy)) {
                    if (group.sub.includes(selectedMuscle)) {
                        category = catKey;
                        break;
                    }
                }
            }

            const newEx = {
                name: formData.get('name'),
                category: category,
                primaryMuscle: formData.get('primaryMuscle'),
                muscles: [formData.get('primaryMuscle')],
                level: formData.get('level'),
                equipment: formData.get('equipment'),
                type: formData.get('type'),
                description: formData.get('description'),
            };

            window.App.addExercise(newEx);
            window.App.closeModal();

            // Refresh catalog
            // Trigger a filter change event or standard refresh logic
            // Since we passed onSuccessCallback which is essentially onFilterChange from the parent
            const filters = {
                search: document.getElementById('filter-search')?.value || '',
                muscle: 'all',
                level: 'all',
                equipment: 'all'
            };
            if (onSuccessCallback) onSuccessCallback(filters);
            alert('Esercizio Aggiunto!');
        });
    }, 100);

};

window.App.renderCatalog = function (exercises) {
    const grid = document.getElementById('catalog-grid');
    if (!grid) return; // Guard clause

    grid.innerHTML = '';

    if (exercises.length === 0) {
        grid.innerHTML = `
            <div class="empty-state">
                <div class="empty-state-title">Nessun esercizio trovato</div>
                <p>Prova a modificare i filtri o ad ampliare la ricerca</p>
                <p class="empty-state-hint">Suggerimento: Rimuovi alcuni filtri per visualizzare più risultati</p>
            </div>
        `;
        return;
    }

    exercises.forEach(ex => {
        const card = document.createElement('div');
        card.className = 'exercise-card';

        // Get quality icon (Safe access)
        const quality = ex.quality || 'N/A';
        const qualityIcons = { 'Forza': '💪', 'Ipertrofia': '📈', 'Potenza': '⚡' };
        const qualityIcon = qualityIcons[quality] || '';
        const qualityClass = quality ? `quality-${quality.toLowerCase()}` : 'secondary';

        card.innerHTML = `
            <div class="card-header">
                <div class="card-tags">
                    <span class="tag ${qualityClass}">${qualityIcon} ${quality}</span>
                    <span class="tag secondary">${translateLevel(ex.level)}</span>
                </div>
                <button class="favorite-btn ${window.App.isFavorite(ex.id) ? 'active' : ''}" data-id="${ex.id}">
                    ${window.App.isFavorite(ex.id) ? '❤️' : '🤍'}
                </button>
            </div>
            <div class="card-body">
                <h3>${ex.name}</h3>
                <p class="muscle-target">${ex.primaryMuscle}</p>
                <p class="description">${ex.description || 'Nessuna descrizione disponibile'}</p>
            </div>
            <div class="card-actions">
                <span class="tag secondary">${ex.equipment}</span>
                <button class="btn-icon" title="Vedi dettagli">→</button>
            </div>
        `;

        // Favorite button handler
        const favoriteBtn = card.querySelector('.favorite-btn');
        favoriteBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const exerciseId = e.currentTarget.dataset.id;
            const isNowFavorite = window.App.toggleFavorite(exerciseId);

            // Update button
            e.currentTarget.classList.toggle('active', isNowFavorite);
            e.currentTarget.textContent = isNowFavorite ? '❤️' : '🤍';

            // Update badge if exists
            if (typeof updateFavoritesBadge === 'function') {
                updateFavoritesBadge();
            }
        });

        // Card click handler (excluding favorite button)
        card.addEventListener('click', (e) => {
            if (!e.target.closest('.favorite-btn')) {
                renderDetail(ex);
            }
        });

        grid.appendChild(card);
    });
};

async function renderDetail(exercise) {
    // 1. Initial Render with New Layout
    // Thematic Icon Logic
    let heroIcon = '🏋️';
    const m = exercise.primaryMuscle.toLowerCase();
    if (m.includes('gambe') || m.includes('quadricipiti') || m.includes('glutei')) heroIcon = '🦵';
    else if (m.includes('petto') || m.includes('spinta')) heroIcon = '💪';
    else if (m.includes('schiena') || m.includes('trazione')) heroIcon = '🦅';
    else if (m.includes('core') || m.includes('addominali')) heroIcon = '🧱';
    else if (m.includes('spalle')) heroIcon = '🥎';

    let content = `
        <div class="exercise-detail-modal">
            <!-- HERO SECTION with Media -->
            <div class="modal-hero">
                <div id="media-container-${exercise.id}" class="modal-media-container">
                    <!-- Placeholder immediately visible -->
                    <div style="width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; background: radial-gradient(circle, #334155 0%, #0f172a 100%); color:rgba(255,255,255,0.1);">
                        <span style="font-size:5rem; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));">${heroIcon}</span>
                    </div>
                </div>
                
                <div class="hero-overlay">
                    <h2 style="font-size:2rem;">${exercise.name}</h2>
                    <p style="color:rgba(255,255,255,0.8); font-size:0.95rem; margin:0;">${exercise.tagline || ''}</p>
                </div>
            </div>

            <!-- SCROLLABLE CONTENT -->
            <div class="modal-scroll-content">
                
                <!-- Unified Metadata Chips -->
                <div class="chip-container">
                    <!-- Essential Tags -->
                    <span class="chip chip--primary">
                        <i class="icon">🔹</i> ${translateType(exercise.type)}
                    </span>
                    <span class="chip">
                        <i class="icon">🛠️</i> ${translateEquipment(exercise.equipment)}
                    </span>
                    <span class="chip">
                        <i class="icon">📶</i> ${translateLevel(exercise.level)}
                    </span>
                    <!-- Muscle Tags (Merged) -->
                    ${exercise.muscles.map(m => `<span class="chip chip--muscle">${m}</span>`).join('')}
                </div>

                <!-- Execution Section -->
                <section class="execution-section">
                    <h3 class="detail-section-title">
                        <i>🏃</i> Come Eseguire
                    </h3>
                    
                    ${exercise.execution ? `
                        <!-- 1. Context -->
                        <div class="exec-context" style="margin-bottom:1.5rem; color:var(--text-secondary); line-height:1.6; font-size:0.95rem;">
                            ${exercise.execution.context || exercise.description}
                        </div>

                        <!-- 2. Setup -->
                        ${exercise.execution.setup ? `
                        <div class="exec-block">
                            <h5 style="color:var(--primary); margin-bottom:0.5rem;">⚙️ Setup Iniziale</h5>
                            <ul class="setup-list" style="padding-left:1.25rem; color:var(--text-primary); margin-bottom:1.5rem;">
                                ${exercise.execution.setup.map(s => `<li>${s}</li>`).join('')}
                            </ul>
                        </div>` : ''}

                        <!-- 3. Steps -->
                        <div class="exec-block">
                            <h5 style="color:var(--primary); margin-bottom:0.5rem;">🔄 Esecuzione</h5>
                            <ul class="step-list">
                                ${(exercise.execution.steps || []).map((step, idx) => `
                                    <li class="step-item">
                                        <span class="step-number">${idx + 1}</span>
                                        <span class="step-text">${step}</span>
                                    </li>
                                `).join('')}
                            </ul>
                        </div>

                        <!-- 4. Cues -->
                        ${exercise.execution.cues ? `
                        <div class="exec-block" style="background:rgba(59,130,246,0.1); padding:1rem; border-radius:var(--radius-sm); border-left:3px solid var(--accent); margin:1.5rem 0;">
                            <h5 style="color:var(--accent); margin-top:0; margin-bottom:0.5rem;">🧠 Cue Tecnici</h5>
                            <ul style="margin:0; padding-left:1.25rem;">
                                ${exercise.execution.cues.map(c => `<li>${c}</li>`).join('')}
                            </ul>
                        </div>` : ''}

                        <!-- 5. Criteria -->
                        ${exercise.execution.criteria ? `
                        <div class="exec-block">
                            <h5 style="color:#10b981; margin-bottom:0.5rem;">✅ Criteri di Validità</h5>
                            <ul style="padding-left:1.25rem; color:var(--text-secondary);">
                                ${exercise.execution.criteria.map(c => `<li>${c}</li>`).join('')}
                            </ul>
                        </div>` : ''}

                    ` : `<div class="bio-box">${exercise.description}</div>`}
                </section>

                <hr style="border:0; border-top:1px solid var(--border); margin: 2.5rem 0;">

                <!-- Errors Section -->
                <section>
                    <h3 class="detail-section-title" style="color: #ef4444;">
                        <i>⚠️</i> Errori Comuni da Evitare
                    </h3>
                    
                    <div class="error-grid">
                        ${(exercise.errors || []).map(err => {
        // Handle both string and object errors for backward compatibility
        const isObj = typeof err === 'object';
        const title = isObj ? err.error : 'Errore Generico';
        const why = isObj ? err.why : '';
        const fix = isObj ? err.fix : '';
        const text = isObj ? '' : err; // Fallback for old strings

        return `
                            <div class="error-card">
                                <h5>🚫 ${title} ${text}</h5>
                                ${why ? `<p style="margin-bottom:0.5rem; font-size:0.9rem; color:#ef4444;"><strong>Perché:</strong> ${why}</p>` : ''}
                                ${fix ? `<p style="font-size:0.9rem; color:var(--text-primary);"><strong>Correzione:</strong> ${fix}</p>` : ''}
                            </div>
                            `;
    }).join('')}
                    </div>
                </section>
            </div>
        </div>
    `;
    window.App.openModal(content);

    // 2. Fetch Media (Async)
    try {
        const media = await window.App.getExerciseMedia(exercise.name);
        const mediaContainer = document.getElementById(`media-container-${exercise.id}`);

        // Only override the thematic hero if we have a REAL video or a specific non-placeholder image
        // Since getExerciseMedia currently returns a placeholder poster by default, we block it unless there's a video.
        if (mediaContainer && media.videoUrl) {
            mediaContainer.innerHTML = `
                <video src="${media.videoUrl}" poster="${media.poster}" controls style="width:100%; height:100%; object-fit:cover; border-radius: var(--radius-md);"></video>
            `;
        }
        // Note: If we had real images (not generic placeholders), we would check for them here.
        // For now, the CSS Hero with the Icon is better than the text-based placeholder.
    } catch (err) {
        console.error('Media load failed', err);
    }
}

// Helpers
function getLevelClass(level) {
    switch (level.toLowerCase()) {
        case 'beginner': return 'badge-green';
        case 'intermediate': return 'badge-yellow';
        case 'advanced': return 'badge-red';
        default: return 'badge-gray';
    }
}

function translateLevel(level) {
    const map = { 'Beginner': 'Principiante', 'Intermediate': 'Intermedio', 'Advanced': 'Avanzato' };
    return map[level] || level;
}

function translateType(type) {
    const map = { 'Compound': 'Multiarticolare', 'Isolation': 'Isolamento', 'Isometric': 'Isometrico' };
    return map[type] || type;
}

function translateEquipment(eq) {
    const map = { 'Bodyweight': 'Corpo Libero', 'Barbell': 'Bilanciere', 'Dumbbell': 'Manubri', 'Machine': 'Macchina', 'Cable': 'Cavi' };
    return map[eq] || eq;
}

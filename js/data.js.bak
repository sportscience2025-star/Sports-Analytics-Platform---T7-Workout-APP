            execution: {
                context: 'Oscillazione balistica del kettlebell usando l\'estensione esplosiva dell\'anca (hip hinge). Allena la potenza della catena posteriore (glutei, femorali) e la resistenza cardiovascolare.',
                setup: ['Piedi leggermente piu\' larghi delle spalle, kettlebell 30-40 cm davanti ai piedi.', 'Afferra il kettlebell con entrambe le mani, schiena piatta, anche flesse.', 'Tira il kettlebell indietro tra le gambe ("hiking" il kettlebell come un pallone da football americano).'],
                steps: ['Estendi le anche in modo esplosivo spingendo il bacino in avanti.', 'Il kettlebell sale per inerzia grazie alla spinta delle anche (non delle braccia).', 'Lascia che il kettlebell salga fino all\'altezza del petto (Russian Swing) o sopra la testa (American Swing).', 'Assorbi il rientro del kettlebell flettendo le anche e reindirizzandolo tra le gambe.'],
                cues: ['Le braccia sono corde: non tirare MAI con le braccia.', 'Stringi i glutei come se volessi rompere una noce.', 'Il movimento e\' un hip hinge esplosivo, non uno squat.'],
                criteria: ['Il kettlebell raggiunge almeno l\'altezza del petto ad ogni ripetizione.', 'L\'anca si estende completamente (lockout) con glutei contratti.']
            },
            errors: [
                { error: 'Usare le braccia per sollevare il kettlebell', why: 'Trasforma l\'esercizio in un front raise, sovraccaricando le spalle e eliminando il lavoro della catena posteriore.', fix: 'Le braccia sono passive: il kettlebell sale SOLO grazie alla spinta delle anche.' },
                { error: 'Fare uno squat invece di un hip hinge', why: 'Lo squat swing recluta i quadricipiti invece della catena posteriore e riduce la velocita\' balistica del movimento.', fix: 'Spingi le anche INDIETRO, non le ginocchia in avanti. Le tibie restano quasi verticali.' },
                { error: 'Arrotondare la schiena durante lo swing', why: 'La colonna arrotondata sotto carico balistico e\' ad altissimo rischio di ernia discale, specialmente nella fase di decelerazione.', fix: 'Mantieni il petto alto e le scapole retratte. Se la schiena si arrotonda, il kettlebell e\' troppo pesante.' }
            ],
            description: 'Oscillazione balistica per la catena posteriore.'
        },

        },
        {
            id: 'frc_ps02', name: 'Military Press',
            primaryMuscle: 'Spalle', muscles: ['Spalle', 'Tricipiti'],
            type: 'Multiarticolare', level: 'Intermedio', equipment: 'Bilanciere', quality: 'Forza',
            execution: {

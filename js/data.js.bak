    window.App.getConditions = function () { return window.App.clinicalConditions; };

    // HELPER: SMART DATA MAPPER (Fixes N/A and Missing Details)
    function enrichExercise(ex) {
        // 1. Map Quality from Type/Level
        if (!ex.quality) {
            if (ex.type === 'Multiarticolare') ex.quality = 'Forza';
            else if (ex.type === 'Isolamento') ex.quality = 'Ipertrofia';
            else if (ex.type === 'Isometrico') ex.quality = 'Stabilità';
            else ex.quality = 'Ipertrofia'; // Fallback
        }

        // 2. Ensure Execution details are present
        if (!ex.execution) {
            if (ex.cues) {
                ex.execution = {
                    bio: ex.description,
                    steps: ex.cues
                };
            } else {
                // Generate generic detailed execution
                ex.execution = {
                    context: ex.description || `Esercizio ${ex.type?.toLowerCase() || 'fondamentale'} per lo sviluppo di ${ex.primaryMuscle || 'vari muscoli'}.`,
                    setup: [
                        `Prepara l'attrezzatura necessaria (${ex.equipment || 'corpo libero'}).`,
                        `Posizionati in modo stabile mantenendo le curve fisiologiche della schiena.`,
                        `Attiva il core per garantire stabilità prima di iniziare il movimento.`
                    ],
                    steps: [
                        `Avvia la fase concentrica esprimendo forza in modo controllato.`,
                        `Mantieni la posizione di massima contrazione per un breve istante.`,
                        `Ritorna alla posizione di partenza controllando lentamente la fase eccentrica.`
                    ],
                    cues: [
                        "Respira fluidamente: espira durante lo sforzo, inspira in discesa.",
                        "Mantieni sempre il controllo del carico.",
                        "Concentrati sulla connessione mente-muscolo."
                    ],
                    criteria: [
                        "Range of motion (ROM) completo e fluido",
                        "Nessun movimento di compenso con altre articolazioni"
                    ]
                };
            }
        }

        // 3. Ensure Errors fallback is present
        if (!ex.errors || !Array.isArray(ex.errors) || ex.errors.length === 0) {
            ex.errors = [
                {
                    error: "Esecuzione troppo veloce o a scatti",
                    why: "Sfruttare l'inerzia riduce il lavoro muscolare effettivo e aumenta notevolmente il rischio di infortuni articolari.",
                    fix: "Rallenta la fase di discesa (eccentrica) a circa 2-3 secondi e controlla il carico."
                },
                {
                    error: "Compensazione o slancio col corpo",
                    why: "Sollevare un carico eccessivo porta a usare muscoli non target, perdendo l'isolamento e l'efficacia dell'esercizio.",
                    fix: "Riduci il peso del 10-20% e concentrati esclusivamente sulla tecnica corretta."
                }
            ];
        }

        // 4. Ensure Description fallback
        if (!ex.description && ex.execution && ex.execution.bio) {
            ex.description = ex.execution.bio;
        }

        return ex;
    }


                { error: 'Atterrare con i gomiti bloccati', why: 'L\'impatto a gomiti bloccati trasmette le forze direttamente a gomiti, spalle e polsi senza ammortizzazione.', fix: 'Atterra con i gomiti leggermente piegati e scendi immediatamente nella fase eccentrica per assorbire l\'impatto.' }
            ],
            description: 'Push-up con stacco delle mani da terra.'
        },
        {
            id: 'pwr_u05', name: 'Overhead Med Ball Throw',
            primaryMuscle: 'Core', muscles: ['Core', 'Spalle'],
            type: 'Multiarticolare', level: 'Intermedio', equipment: 'Attrezzi', quality: 'Potenza',
            execution: {
                context: 'Lancio della palla medica da sopra la testa verso un muro o un partner. Sviluppa la potenza di estensione dell\'intera catena posteriore e la coordinazione full-body.',
                setup: ['In piedi, 2-3 metri da un muro, palla medica tenuta sopra la testa.', 'Piedi alla larghezza delle spalle.', 'Leggera inclinazione indietro per caricare.'],
                steps: ['Carica estendendo il corpo e portando la palla dietro la testa.', 'Lancia la palla in avanti e in alto usando core, spalle e braccia.', 'Segui il lancio con tutto il corpo (follow-through).'],
                cues: ['La potenza parte dai piedi e attraversa tutto il corpo.', 'Lancia ATTRAVERSO il bersaglio, non verso di esso.', 'Il core si contrae potentemente durante il rilascio.'],
                criteria: ['Follow-through completo del corpo.', 'La palla raggiunge il bersaglio con velocita\'.']
            },
            errors: [
                { error: 'Lanciare solo con le braccia', why: 'Le braccia da sole generano una frazione della potenza disponibile. Il core e le gambe sono i motori principali.', fix: 'Inizia il lancio dai piedi, trasferisci attraverso le anche e il core, e rilascia con le braccia.' },
                { error: 'Iperestendere la zona lombare nella fase di carico', why: 'Caricare con iperestensione lombare sotto il peso della palla puo\' causare compressione dei dischi.', fix: 'Carica con estensione TORACICA (petto in fuori), non lombare. Mantieni gli addominali contratti.' }
            ],
            description: 'Lancio palla medica da sopra la testa.'
        },
        {
            id: 'pwr_u06', name: 'Clap Push-up',
            primaryMuscle: 'Petto', muscles: ['Petto', 'Tricipiti'],
            type: 'Multiarticolare', level: 'Avanzato', equipment: 'Corpo Libero', quality: 'Potenza',
            execution: {
                context: 'Push-up esplosivo con battuta delle mani in aria. Livello avanzato del plyo push-up: richiede potenza e coordinazione maggiori per battere le mani e riatterrare in sicurezza.',
                setup: ['Posizione di push-up standard con corpo rigido.', 'Mani leggermente piu\' larghe delle spalle.', 'Core e glutei estremamente attivi.'],
                steps: ['Scendi controllando il petto al pavimento.', 'Esplodi verso l\'alto con potenza massima.', 'In aria, batti le mani una volta davanti al petto.', 'Riapri le mani e atterra morbidamente riprendendo la posizione di push-up.'],
                cues: ['La battuta deve essere rapida: non restare troppo in aria.', 'Apri le mani PRIMA dell\'atterraggio.', 'Atterra con i gomiti leggermente piegati.'],
                criteria: ['Battuta delle mani chiara e udibile.', 'Atterraggio stabile e controllato.']
            },
            errors: [
                { error: 'Non riaprire le mani in tempo per l\'atterraggio', why: 'Atterrare con le mani chiuse o semi-chiuse puo\' causare fratture ai polsi e alle dita.', fix: 'La battuta e\' brevissima: batti e riapri immediatamente. Se non riesci, torna al plyo push-up senza battuta.' },
                { error: 'Perdere la posizione del corpo durante il volo', why: 'Un corpo disallineato in fase aerea causa atterraggi asimmetrici che sovraccaricano un polso piu\' dell\'altro.', fix: 'Mantieni il core estremamente contratto: il corpo deve restare rigido come un\'asse in ogni fase.' }
            ],
            description: 'Push-up con battuta mani in aria.'
        },

        // Full Body
        {
            id: 'pwr_f01', name: 'Barbell Clean',
            primaryMuscle: 'Gambe', muscles: ['Gambe', 'Schiena', 'Trapezio'],
            type: 'Multiarticolare', level: 'Pro', equipment: 'Bilanciere', quality: 'Potenza',
            execution: {
                context: 'Girata olimpica: sollevamento esplosivo del bilanciere dal pavimento alla posizione di front rack. Richiede tecnica impeccabile e coordina l\'intera catena cinetica.',
                setup: ['Piedi alla larghezza delle anche, bilanciere sopra la meta\' del piede.', 'Afferra il bilanciere con presa prona leggermente piu\' larga delle spalle.', 'Schiena piatta, petto alto, spalle sopra o leggermente avanti al bilanciere.'],
                steps: ['Prima tirata: solleva il bilanciere dal pavimento estendendo le ginocchia (il busto mantiene l\'angolo).', 'Seconda tirata: quando il bilanciere supera le ginocchia, esplodi con le anche (triple extension).', 'Terza tirata: tira i gomiti in alto e in fuori (tirata alta).', 'Infilati sotto il bilanciere ruotando i gomiti e ricevilo sulle clavicole in posizione di front squat.'],
                cues: ['Il bilanciere resta vicino al corpo in ogni fase.', 'L\'esplosione e\' alle ANCHE, non alle braccia.', 'Infilati sotto il bilanciere: non tirarlo in alto con le braccia.'],
                criteria: ['Il bilanciere finisce in posizione stabile di front rack.', 'La ricezione avviene in posizione di front squat controllato.']
            },
            errors: [
                { error: 'Tirare con le braccia prima dell\'estensione delle anche', why: 'Le braccia sono corde: tirare presto riduce la potenza del 50% e sovraccarica bicipiti e polsi.', fix: 'Le braccia si piegano SOLO dopo la completa estensione di anche-ginocchia-caviglie.' },
                { error: 'Il bilanciere si allontana dal corpo', why: 'Un bilanciere lontano dal baricentro crea una leva che sovraccarica la schiena e rende impossibile la ricezione pulita.', fix: 'Il bilanciere deve sfiorare le cosce e l\'addome durante la tirata. Pensa a "spazzolarti la maglietta".' },
                { error: 'Ricezione rigida senza ammortizzazione', why: 'Ricevere il bilanciere con le gambe tese scarica l\'impatto sulle articolazioni invece che sulla muscolatura.', fix: 'Ricevi in posizione di front squat parziale o completo, ammortizzando con le gambe.' }
            ],
            description: 'Strappo olimpico completo esplosivo.'
        },
        {
            id: 'pwr_f02', name: 'Jump Rope Speed',
            primaryMuscle: 'Polpacci', muscles: ['Polpacci'],
            type: 'Isolamento', level: 'Intermedio', equipment: 'Attrezzi', quality: 'Potenza',
            execution: {
                context: 'Salto alla corda a ritmo veloce (200+ rpm). Allena la coordinazione mano-piede, la reattivita\' della caviglia e la resistenza cardiovascolare.',
                setup: ['Corda della lunghezza corretta (impugnature all\'altezza delle ascelle quando si calpesta il centro).', 'In piedi con i piedi uniti, ginocchia leggermente flesse.', 'Gomiti vicini ai fianchi, impugnature nelle mani.'],
                steps: ['Inizia con salti bassi (2-3 cm dal suolo) a un ritmo confortevole.', 'Progressivamente aumenta la velocita\' di rotazione della corda.', 'Mantieni il ritmo costante respirando in modo controllato.'],
                cues: ['I salti sono MINIMI: solo lo spazio per far passare la corda.', 'I polsi girano la corda, non le braccia.', 'Rimani sugli avampiedi: i talloni non toccano mai il suolo.'],
                criteria: ['Ritmo costante senza inciampi.', 'Salti bassi e rapidi.']
            },
            errors: [
                { error: 'Saltare troppo in alto', why: 'Salti alti sprecano energia, rallentano il ritmo e aumentano l\'impatto sulle articolazioni.', fix: 'Salta appena 2-3 cm: giusto lo spazio per far passare la corda sotto i piedi.' },
                { error: 'Ruotare la corda con le braccia intere', why: 'Usare le braccia per girare la corda affatica le spalle e rallenta la velocita\' di rotazione.', fix: 'I gomiti restano fermi ai fianchi: solo i polsi ruotano.' }
            ],
            description: 'Corda a ritmo velocissimo (200+ rpm).'
        },
        {
            id: 'pwr_f03', name: 'Barbell Snatch',
            primaryMuscle: 'Gambe', muscles: ['Gambe', 'Schiena', 'Spalle'],
            type: 'Multiarticolare', level: 'Pro', equipment: 'Bilanciere', quality: 'Potenza',
            execution: {
                context: 'Strappo olimpico: il bilanciere viene sollevato dal pavimento fino sopra la testa in un unico movimento esplosivo. L\'esercizio piu\' tecnico e potente esistente.',
                setup: ['Piedi alla larghezza delle anche, presa snatch ampia (indice sul ring del bilanciere olimpico).', 'Schiena piatta, petto alto, anche piu\' basse del Clean.', 'Braccia completamente tese, spalle sopra il bilanciere.'],
                steps: ['Prima tirata: solleva il bilanciere estendendo le ginocchia.', 'Seconda tirata: estensione esplosiva delle anche (hip drive).', 'Terza tirata: tira te stesso SOTTO il bilanciere, ruotando le braccia per riceverlo sopra la testa.', 'Ricevi il bilanciere in overhead squat con braccia bloccate.'],
                cues: ['Il bilanciere viaggia in linea retta verso l\'alto.', 'L\'esplosione avviene alle anche, le braccia sono corde.', 'Infilati sotto e blocca le braccia: non spingere in alto.'],
                criteria: ['Ricezione stabile in overhead squat.', 'Braccia completamente bloccate sopra la testa nella ricezione.']
            },
            errors: [
                { error: 'Presa troppo stretta', why: 'Una presa stretta obbliga a tirare il bilanciere piu\' in alto, riducendo l\'efficienza e aumentando il rischio di mancata ricezione.', fix: 'Usa la presa snatch corretta: il bilanciere deve arrivare all\'altezza della piega dell\'anca quando sei in piedi con le braccia tese.' },
                { error: 'Ricevere il bilanciere con le braccia piegate', why: 'Braccia piegate nella ricezione possono collassare sotto il peso, causando infortuni a spalle e gomiti.', fix: 'Blocca i gomiti PRIMA che il bilanciere arrivi alla massima altezza. La ricezione e\' a braccia rigide.' }
            ],
            description: 'Strappo olimpico massimale.'
        },

        // --- NEW: FORZA (FORCE) ---
        // Squat & Deadlift
        {
            id: 'frc_sq01', name: 'Back Squat Pesante',
            primaryMuscle: 'Gambe', muscles: ['Quadricipiti', 'Glutei'],
            type: 'Multiarticolare', level: 'Avanzato', equipment: 'Bilanciere', quality: 'Forza',
            execution: {
                context: 'Re degli esercizi per la forza: squat profondo con bilanciere al 85-95% del massimale. Allena quadricipiti, glutei, core e l\'intera catena cinetica in modo insuperabile.',
                setup: ['Bilanciere sulla parte alta dei trapezi (high bar) o sulla spina della scapola (low bar).', 'Piedi alla larghezza delle spalle o leggermente piu\' larghi, punte extraruotate 15-30 gradi.', 'Grande inspirazione, Valsalva, core rigidissimo.'],
                steps: ['Sblocca il bilanciere e fai 2-3 passi indietro (unracking).', 'Scendi controllando, spingendo le ginocchia in fuori seguendo le punte dei piedi.', 'Scendi almeno al parallelo (piega dell\'anca all\'altezza del ginocchio).', 'Risali spingendo il pavimento con tutto il piede, mantenendo il petto alto.'],
                cues: ['Spingi il pavimento lontano da te.', 'Petto alto: non cedere in avanti.', 'Le ginocchia seguono la direzione delle punte dei piedi.'],
                criteria: ['Piega dell\'anca al parallelo o sotto.', 'Il bilanciere si muove in linea verticale sul centro del piede.']
            },
            errors: [
                { error: 'Butt wink (retroversione del bacino nel fondo)', why: 'La zona lombare si arrotonda sotto carico pesante, creando forze di taglio pericolose sui dischi lombari.', fix: 'Scendi solo fino al punto dove la zona lombare resta neutra. Lavora sulla mobilita\' dell\'anca e delle caviglie.' },
                { error: 'Good morning squat (la risalita inizia con le anche)', why: 'Il bilanciere si sposta in avanti, trasformando lo squat in un good morning e sovraccaricando la zona lombare.', fix: 'Pensa a spingere la schiena CONTRO il bilanciere durante la risalita. Anche e spalle salgono alla stessa velocita\'.' },
                { error: 'Valgo delle ginocchia (ginocchia verso l\'interno)', why: 'Indica debolezza dei glutei medi e mette stress enorme su LCA e menisco mediale.', fix: 'Spingi attivamente le ginocchia in fuori durante tutto il movimento, specialmente nella risalita.' }
            ],
            description: 'Squat profondo 85-95% 1RM.'
        },
        {
            id: 'frc_sq02', name: 'Front Squat',
            primaryMuscle: 'Gambe', muscles: ['Quadricipiti', 'Core'],
            type: 'Multiarticolare', level: 'Intermedio', equipment: 'Bilanciere', quality: 'Forza',
            execution: {
                context: 'Squat con bilanciere in posizione anteriore (front rack). Il carico anteriore obbliga a un busto piu\' verticale, reclutando maggiormente i quadricipiti e il core.',
                setup: ['Bilanciere sulle clavicole/deltoidi anteriori con presa clean (gomiti alti) o braccia incrociate.', 'Piedi alla larghezza delle spalle, punte leggermente extraruotate.', 'Gomiti il piu\' ALTI possibile.'],
                steps: ['Scendi mantenendo il busto il piu\' verticale possibile.', 'I gomiti restano alti durante tutta la discesa.', 'Scendi al parallelo o sotto.', 'Risali guidando con i gomiti verso l\'alto.'],
                cues: ['Gomiti ALTI: se calano, il bilanciere cade.', 'Il busto e\' piu\' verticale del back squat.', 'Pensa a sederti tra le gambe, non indietro.'],
                criteria: ['I gomiti restano paralleli al pavimento o piu\' alti.', 'Il busto resta quasi verticale.']
            },
            errors: [
                { error: 'I gomiti calano perdendo il front rack', why: 'Gomiti bassi = il bilanciere scivola in avanti e cade. Con carichi pesanti e\' estremamente pericoloso.', fix: 'Lavora sulla mobilita\' dei polsi, dei dorsali e dei tricipiti. I gomiti devono puntare verso il muro di fronte.' },
                { error: 'Inclinarsi in avanti eccessivamente', why: 'Nel front squat il busto deve essere quasi verticale. Un\'inclinazione eccessiva sposta il carico sulla schiena e rischia la perdita del bilanciere.', fix: 'Pensa a tenere il petto orgogliosamente in fuori. Se il busto cede, riduci il carico e lavora sulla mobilita\' toracica.' }
            ],
            description: 'Squat con bilanciere anteriore 75-85% 1RM.'
        },
        {
            id: 'frc_sq03', name: 'Deadlift',
            primaryMuscle: 'Schiena', muscles: ['Schiena', 'Glutei', 'Femorali'],
            type: 'Multiarticolare', level: 'Avanzato', equipment: 'Bilanciere', quality: 'Forza',
            execution: {
                context: 'Stacco da terra convenzionale: il singolo esercizio che permette di sollevare il carico piu\' pesante in assoluto. Allena l\'intera catena posteriore e il grip.',
                setup: ['Piedi alla larghezza delle anche, bilanciere sopra la meta\' del piede (2-3 cm dagli stinchi).', 'Presa mista o doppia prona, mani appena fuori dalle ginocchia.', 'Schiena piatta, petto alto, anche piu\' alte delle ginocchia ma piu\' basse delle spalle.'],
                steps: ['Spingi il pavimento con i piedi (come una leg press) mantenendo la schiena nell\'angolo iniziale.', 'Quando il bilanciere supera le ginocchia, estendi le anche portando il bacino in avanti.', 'Lockout: in piedi con anche e ginocchia completamente estese, spalle indietro.', 'Scendi invertendo il movimento: anche indietro, poi ginocchia.'],
                cues: ['Il bilanciere resta attaccato al corpo: sfiora gli stinchi e le cosce.', 'Spingi il pavimento, non tirare il bilanciere.', 'Petto alto e schiena piatta come una tavola.'],
                criteria: ['Il bilanciere si muove in linea retta verticale.', 'La schiena mantiene la curva naturale durante tutto il sollevamento.']
            },
            errors: [
                { error: 'Arrotondare la zona lombare (cat back)', why: 'La flessione lombare sotto carico massimale e\' la causa numero uno di ernie discali nello stacco.', fix: 'Se la schiena si arrotonda, il carico e\' troppo pesante. Riduci e lavora sulla tecnica. Usa la respirazione Valsalva per stabilizzare.' },
                { error: 'Il bilanciere si allontana dal corpo', why: 'Un bilanciere lontano crea un braccio di leva che moltiplica lo stress sulla zona lombare in modo esponenziale.', fix: 'Il bilanciere deve SFIORARE gli stinchi durante la salita. Pensa a raschiare i pantaloni.' },
                { error: 'Iperestensione al lockout', why: 'Tirare indietro le spalle iperestendendo la colonna crea compressione sulle faccette articolari lombari.', fix: 'Al lockout, stai semplicemente in piedi con la colonna in posizione neutra. Non tirare le spalle indietro in modo esagerato.' }
            ],
            description: 'Stacco da terra massimale 80-95% 1RM.'
        },
        {
            id: 'frc_sq04', name: 'Sumo Deadlift',
            primaryMuscle: 'Gambe', muscles: ['Glutei', 'Adduttori', 'Schiena'],
            type: 'Multiarticolare', level: 'Intermedio', equipment: 'Bilanciere', quality: 'Forza',
            execution: {
                context: 'Stacco da terra con stance ampia e presa interna. Riduce il ROM e l\'inclinazione del busto, reclutando maggiormente glutei e adduttori rispetto al convenzionale.',
                setup: ['Piedi molto piu\' larghi delle spalle (punte a 45+ gradi verso l\'esterno).', 'Mani tra le gambe, alla larghezza delle spalle.', 'Schiena piatta, petto alto, anche il piu\' vicine possibile al bilanciere.'],
                steps: ['Spingi le ginocchia in fuori e spingi il pavimento con i piedi.', 'Estendi anche e ginocchia simultaneamente.', 'Il bilanciere sale in linea retta mantenendosi vicino al corpo.', 'Lockout con piena estensione di anche e ginocchia.'],
                cues: ['Spingi le ginocchia verso le braccia.', 'Il busto resta piu\' verticale del convenzionale.', 'Spingi il pavimento "ai lati" con i piedi.'],
                criteria: ['Le ginocchia non collassano verso l\'interno.', 'Il busto resta relativamente verticale.']
            },
            errors: [
                { error: 'Le ginocchia crollano verso l\'interno durante la tirata', why: 'Il valgo nel sumo deadlift stressa enormemente adduttori e legamenti del ginocchio, causa comune di infortuni inguinali.', fix: 'Spingi attivamente le ginocchia verso l\'esterno per tutta la durata della tirata. Se crollano, il carico e\' troppo.' },
                { error: 'Le anche si alzano prima delle spalle (stacco col sedere)', why: 'Trasforma il sumo in una posizione simile al convenzionale, eliminando il vantaggio biomeccanico della stance ampia.', fix: 'Spalle e anche devono salire alla stessa velocita\'. Pensa a spingere il pavimento, non a tirare il bilanciere.' }
            ],
            description: 'Stacco sumo ampia stance.'
        },
        {
            id: 'frc_sq05', name: 'Pin Squat',
            primaryMuscle: 'Gambe', muscles: ['Quadricipiti'],
            type: 'Multiarticolare', level: 'Avanzato', equipment: 'Bilanciere', quality: 'Forza',
            execution: {
                context: 'Squat che parte dai pin/sicure del rack nella posizione bassa. Elimina il ciclo stiramento-accorciamento, allenando la forza concentrica pura dal bottom.',
                setup: ['Posiziona i pin del rack all\'altezza del parallelo o leggermente sotto.', 'Posizionati sotto il bilanciere che giace sui pin, nella posizione bassa dello squat.', 'Schiena piatta, core attivissimo in Valsalva.'],
                steps: ['Da fermo sui pin, esplodi verso l\'alto estendendo anche e ginocchia.', 'Completa l\'estensione fino al lockout.', 'Scendi controllando e appoggia il bilanciere delicatamente sui pin.', 'Pausa completa, poi ripeti.'],
                cues: ['Ogni ripetizione parte da ZERO: nessun rimbalzo, nessun riflesso elastico.', 'Spingi il pavimento con violenza.', 'Mantieni la schiena rigida durante la partenza.'],
                criteria: ['Pausa completa sui pin tra ogni ripetizione.', 'Nessun rimbalzo del bilanciere sui pin.']
            },
            errors: [
                { error: 'Rimbalzare il bilanciere sui pin', why: 'Il rimbalzo reintroduce l\'inerzia, eliminando lo scopo dell\'esercizio (forza concentrica pura).', fix: 'Appoggia delicatamente il bilanciere e attendi 1-2 secondi di pausa completa prima di ogni ripetizione.' },
                { error: 'Partire con la schiena arrotondata', why: 'Senza la fase eccentrica che ti prepara, e\' facile trovarsi nella posizione bassa con una schiena non preparata.', fix: 'Prima di iniziare la spinta, controlla attivamente la posizione: petto alto, schiena piatta, Valsalva attiva.' }
            ],
            description: 'Squat partendo dai pin del rack.'
        },
        {
            id: 'frc_sq06', name: 'Deficit Deadlift',
            primaryMuscle: 'Schiena', muscles: ['Schiena', 'Femorali'],
            type: 'Multiarticolare', level: 'Avanzato', equipment: 'Bilanciere', quality: 'Forza',
            execution: {
                context: 'Stacco da terra eseguito da un rialzo (2.5-10 cm). Il ROM aumentato allena specificamente la forza dal pavimento (first pull), punto debole di molti staccatori.',
                setup: ['Posizionati su un rialzo (bumper plate, step) alto 2.5-10 cm.', 'Setup identico al deadlift convenzionale, ma le anche partono piu\' basse.', 'Schiena piatta, petto alto, core in Valsalva.'],
                steps: ['Spingi il pavimento estendendo le gambe, mantenendo l\'angolo della schiena.', 'Superate le ginocchia, estendi le anche come nel deadlift classico.', 'Lockout completo.', 'Scendi controllando fino a che i dischi toccano il rialzo.'],
                cues: ['Le anche partono PIU\' BASSE del deadlift normale.', 'La schiena deve essere PERFETTA: il deficit non perdona errori tecnici.', 'Usa un carico inferiore (80-85%) rispetto al tuo deadlift dal pavimento.'],
                criteria: ['La schiena mantiene la curva neutra nonostante il ROM aumentato.', 'Il bilanciere resta vicino al corpo.']
            },
            errors: [
                { error: 'Usare un rialzo troppo alto', why: 'Un deficit eccessivo forza la schiena ad arrotondarsi per raggiungere il bilanciere, creando rischio di infortunio lombare.', fix: 'Inizia con 2.5 cm e aumenta solo se riesci a mantenere la schiena perfettamente piatta. Non superare mai i 10 cm.' },
                { error: 'Arrotondare la schiena nel punto piu\' basso', why: 'Il ROM aumentato rende ancora piu\' probabile la flessione lombare sotto carico rispetto al deadlift standard.', fix: 'Riduci il peso del 15-20% rispetto al tuo deadlift classico. Se la schiena si arrotonda, il deficit e\' troppo o il carico e\' eccessivo.' }
            ],
            description: 'Stacco da rialzo, ROM aumentato.'
        },
        {
            id: 'frc_sq07', name: 'Pause Squat',
            primaryMuscle: 'Gambe', muscles: ['Quadricipiti'],
            type: 'Multiarticolare', level: 'Avanzato', equipment: 'Bilanciere', quality: 'Forza',
            execution: {
                context: 'Squat con pausa isometrica di 2-3 secondi nella posizione piu\' bassa (bottom). Elimina il riflesso miotatico e costruisce forza e fiducia nel punto piu\' debole dello squat.',
                setup: ['Setup identico al back squat.', 'Usa il 70-80% del tuo squat massimale.', 'Core in Valsalva, schiena rigida.'],
                steps: ['Scendi controllando fino alla posizione piu\' bassa (parallelo o sotto).', 'FERMATI per 2-3 secondi mantenendo TUTTA la tensione muscolare.', 'Esplodi verso l\'alto dalla posizione di pausa.'],
                cues: ['La pausa e\' nel punto PIU\' difficile: non rilassarti.', 'Conta mentalmente "mille-uno, mille-due, mille-tre" poi esplodi.', 'Mantieni la pressione intra-addominale durante tutta la pausa.'],
                criteria: ['Pausa visibile e completa di almeno 2 secondi nella buca.', 'Nessuna oscillazione o rimbalzo per uscire dalla buca.']
            },
            errors: [
                { error: 'Rilassarsi durante la pausa (perdere la tensione)', why: 'La perdita di tensione nella buca rende la risalita molto piu\' difficile e pericolosa, rischiando il cedimento della colonna.', fix: 'Mantieni tutto contratto durante la pausa: core, glutei, quadricipiti. Solo le anche si fermano, non i muscoli.' },
                { error: 'Usare un carico troppo pesante', why: 'Il pause squat senza il riflesso miotatico e\' significativamente piu\' difficile. Un carico da squat normale potrebbe schiacciare.', fix: 'Inizia con il 70% del tuo squat massimale e progredisci lentamente.' }
            ],
            description: 'Squat con pausa isometrica al fondo.'
        },

        // Push & Pull

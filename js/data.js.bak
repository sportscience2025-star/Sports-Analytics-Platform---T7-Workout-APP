                context: 'Salti rimbalzanti continui con contatto al suolo minimo. Allena la rigidita\' reattiva del complesso caviglia-polpaccio e il ciclo stiramento-accorciamento rapido del tendine d\'Achille.',
                setup: ['In piedi con i piedi uniti, ginocchia quasi bloccate.', 'Braccia lungo i fianchi o le mani sui fianchi.', 'Corpo rigido come una molla.'],
                steps: ['Salta in alto usando SOLO le caviglie (plantarflessione), senza piegare le ginocchia.', 'Atterra sugli avampiedi e rimbalza immediatamente verso l\'alto.', 'Il tempo di contatto al suolo deve essere il piu\' breve possibile (< 200ms).'],
                cues: ['Immagina che il pavimento sia rovente: tocca e vai.', 'Ginocchia rigide: le gambe sono bastoni.', 'Rimbalza come una pallina di gomma.'],
                criteria: ['Tempo di contatto al suolo minimo.', 'Ginocchia che non si piegano durante il rimbalzo.']
            },
            errors: [

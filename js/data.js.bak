    // INIT
    window.App.initData = function () {
        if (!window.App.exercises) return;
        if (window.App._dataInitialized) return;
        window.App.exercises = window.App.exercises.map(enrichExercise);
        window.App._dataInitialized = true;
        console.log(`Loaded and enriched ${window.App.exercises.length} exercises from data.js`);
    };

    // Auto-init immediately
    window.App.initData();

    // Expose Filtering Logic
    window.App.getExercises = function (filters) {
        if (!window.App._dataInitialized) window.App.initData();

        let results = window.App.exercises;

        if (filters) {
            // 1. Search (Name or Muscle)
            if (filters.search) {
                const term = filters.search.toLowerCase();
                results = results.filter(ex =>
                    ex.name.toLowerCase().includes(term) ||
                    (ex.muscles && ex.muscles.some(m => m.toLowerCase().includes(term)))
                );
            }

            // 2. Body Part (Muscle)
            if (filters.muscle && filters.muscle !== 'all') {
                results = results.filter(ex =>
                    ex.primaryMuscle === filters.muscle ||
                    (ex.muscles && ex.muscles.includes(filters.muscle))
                );
            }

            // 3. Level
            if (filters.level && filters.level !== 'all') {
                results = results.filter(ex => ex.level === filters.level);
            }

            // 4. Equipment
            if (filters.equipment && filters.equipment !== 'all') {
                results = results.filter(ex => ex.equipment === filters.equipment);
            }

            // 5. Quality (Goal)
            if (filters.quality && filters.quality !== 'all') {
                results = results.filter(ex => ex.quality && ex.quality.includes(filters.quality));
                // Using .includes() allows "Ipertrofia / Forza" to match both (if we kept it), 
                // but we are cleaning it up anyway.
            }
        }

        return results;
    };

    // EXPOSE FAVORITE HELPER TO DATA LAYER for persistence
    window.App.favorites = JSON.parse(localStorage.getItem('t7_favorites')) || [];

    window.App.toggleFavorite = function (id) {
        const index = window.App.favorites.indexOf(id);
        if (index === -1) {
            window.App.favorites.push(id);
        } else {
            window.App.favorites.splice(index, 1);
        }
        localStorage.setItem('t7_favorites', JSON.stringify(window.App.favorites));
        return index === -1; // true if added
    };

    window.App.isFavorite = function (id) {
        return window.App.favorites.includes(id);
    };

    window.App.getFavoriteExercises = function () {
        if (!window.App._dataInitialized) window.App.initData();
        return window.App.exercises.filter(ex => window.App.favorites.includes(ex.id));
    };

})();

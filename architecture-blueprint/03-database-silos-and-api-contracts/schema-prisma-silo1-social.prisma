// ==============================================================================
// SILO 1: PUBLIC, SOCIAL & MOVELY B2B/B2C DATABASE SCHEMA
// Provider: PostgreSQL / Neon
// Target: Atleti amatoriali Tier 1, Professionisti P.IVA, Feed Social e Marketplace
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_SILO1_SOCIAL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/silo1-client"
}

enum UserRole {
  ATHLETE_BASE
  COACH_FREELANCE
  PHYSIO_FREELANCE
  NUTRITIONIST
  SUPERADMIN
}

enum TierLevel {
  TIER_1_BASE
  TIER_2_PRO
  TIER_3_ELITE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REFUNDED
}

model User {
  id              String               @id @default(uuid())
  email           String               @unique
  passwordHash    String
  role            UserRole             @default(ATHLETE_BASE)
  tierLevel       TierLevel            @default(TIER_1_BASE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  profile         Profile?
  socialPosts     SocialPost[]
  comments        PostComment[]
  bookingsMade    MarketplaceBooking[] @relation("ClientBookings")
  bookingsReceived MarketplaceBooking[] @relation("ProfessionalBookings")
  clientPlans     ClientMacrocycle[]   @relation("ClientPlans")
  authoredPlans   ClientMacrocycle[]   @relation("CoachAuthoredPlans")

  @@map("users")
}

model Profile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  fiscalCode      String?
  avatarUrl       String?
  bio             String?
  isProfessional  Boolean   @default(false)
  vatNumber       String?   // Partita IVA per professionisti
  servicesOffered String[]  // es: ["PERSONAL_TRAINING", "REHAB_CONSULTING", "VBT_COACHING"]
  hourlyRateEur   Decimal?  @db.Decimal(10, 2)
  city            String?
  country         String    @default("IT")
  updatedAt       DateTime  @updatedAt

  @@map("profiles")
}

model SocialPost {
  id          String        @id @default(uuid())
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String        @db.Text
  mediaUrl    String?
  likesCount  Int           @default(0)
  createdAt   DateTime      @default(now())
  comments    PostComment[]

  @@map("social_posts")
}

model PostComment {
  id        String     @id @default(uuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String     @db.Text
  createdAt DateTime   @default(now())

  @@map("post_comments")
}

model MarketplaceBooking {
  id                    String        @id @default(uuid())
  clientId              String
  client                User          @relation("ClientBookings", fields: [clientId], references: [id])
  professionalId        String
  professional          User          @relation("ProfessionalBookings", fields: [professionalId], references: [id])
  serviceType           String
  amountEur             Decimal       @db.Decimal(10, 2)
  stripePaymentIntentId String        @unique
  status                BookingStatus @default(PENDING)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("marketplace_bookings")
}

model ClientMacrocycle {
  id            String    @id @default(uuid())
  clientId      String
  client        User      @relation("ClientPlans", fields: [clientId], references: [id])
  coachId       String
  coach         User      @relation("CoachAuthoredPlans", fields: [coachId], references: [id])
  title         String
  durationWeeks Int       @default(12)
  scheduleData  Json      // Contiene le settimane, sessioni, serie ed esercizi con note
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("client_macrocycles")
}

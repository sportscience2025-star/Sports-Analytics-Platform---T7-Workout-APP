    classDef gateway fill:#475569,stroke:#94a3b8,stroke-width:2px,color:#ffffff;
    classDef engine fill:#1e1b4b,stroke:#818cf8,stroke-width:2px,color:#e0e7ff;
    classDef silo1 fill:#064e3b,stroke:#34d399,stroke-width:2px,color:#d1fae5;
    classDef silo2 fill:#4c0519,stroke:#f43f5e,stroke-width:2px,color:#ffe4e6;

flowchart TD
    classDef startend fill:#0f766e,stroke:#14b8a6,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;
    classDef warning fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef verified fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d,font-weight:bold;

    TITLE["SOFTWARE 1 (B2C CONSUMER) - FLOW 1A: ACCESSO, ONBOARDING & ANAMNESI ANTI-FRODE (T7 CONSUMER)"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (MOBILE & PWA)"]
        START(["Inizio: Apertura App Consumer"]):::startend
        SPLASH["Welcome Screen: Portale Atleta & Onboarding Consumer"]:::client
        AUTH_FORK{"Account Esistente?"}:::decision
        
        LOGIN_VIEW["1-Tap Passkey FaceID/TouchID / Social Sign-In / Email+Password"]:::client
        LOGIN_SEC["Verifica Sicurezza, Rilevamento Anomalie & Recupero OTP"]:::client
        
        REG_STEP1["Step 1: Scudo Cloudflare Turnstile & 1-Tap Sign-In (Apple/Google/Passkey)"]:::client
        REG_STEP2["Step 2: Parametri Fisiologici (Sesso Biologico per BMR, Altezza, Peso, Spunta 18+)"]:::client
        AGE_GATE{"Spunta 18+ & Consensi Privacy?"}:::decision
        ERR_AGE["Blocco Registrazione: Termini o Maggiore Età Non Accettati"]:::error
        
        REG_STEP3["Step 3: Screening Sanitario PAR-Q+ (7 Red Flags) & Clickwrap Waiver"]:::client
        PARQ_GATE{"Rilevate Red Flags Sanitarie?"}:::decision
        PARQ_ALERT["Avviso Medico Obbligatorio: Schede Limitate a Low-Impact & Visita Consigliata"]:::warning
        PARQ_OK["Idoneità Funzionale Piena: Sblocco Esercizi Completi & VBT"]:::verified
        
        REG_STEP4["Step 4: Provisioning Profilo Atleta & Rilascio Token JWT Tier 1"]:::client
        SOCIAL_GATE{"Accesso Community Together / Movely?"}:::decision
        STEP_UP_SMS["Step-Up SMS OTP Telefono: Shield Anti-Spam & Anti-Troll"]:::client
        
        COCKPIT_READY["INGRESSO COCKPIT DASHBOARD ATLETA (SESSIONE CONSUMER ATTIVA)"]:::startend
        NAV_HUB["➔ NAVIGA ALL'HUB CENTRALE (SEZIONE 2)"]:::client
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & ACCESS CONTROL"]
        GW_BOT_FILTER{"Filtro Bot Cloudflare Turnstile & Device Fingerprint?"}:::decision
        GW_RATE_LIMIT{"Controllo Rate Limiting IP & Blocco Disposable Domains?"}:::decision
        GW_AUTH_VALIDATE["Validazione WebAuthn Attestation / OAuth Token Apple & Google"]:::gateway
        GW_PARQ_AUDIT["Audit Log Immutabile: Archiviazione Risposte PAR-Q+ & Timestamp Waiver"]:::gateway
        GW_JWT_EMIT["Emissione Token JWT Tier 1 (Role: R1 Athlete) + Silent Refresh Cookie"]:::gateway
        GW_STEP_UP_VERIFY["Gateway OTP SMS Twilio: Verifica Numero di Telefono"]:::gateway
    end

    subgraph LANE_SERVER["CORSIA 3: SERVER SCATOLA NERA (CONSUMER ENGINE)"]
        SRV_BMR_CALC["Calcolo Fabbisogno Energetico & BMR (Mifflin-St Jeor da Sesso/Altezza/Peso)"]:::server
        SRV_TRIAGE_FILTER["Filtro Algoritmico Esercizi: Adattamento Low-Impact se Red Flags = SÌ"]:::server
        SRV_PROVISION_B2C["Inizializzazione Silo 1 Consumer Partition & Defaults Streak = 0"]:::server
    end

    subgraph LANE_DB["CORSIA 4: DATABASE SILO 1 (CONSUMER DATA ISOLATION)"]
        DB_USERS[("auth_users: Credenziali Cifrate Argon2id o Provider OAuth")]:::db
        DB_PROFILES[("athlete_profiles: Anagrafica, Parametri Biometrici e Consensi")]:::db
        DB_HEALTH_AUDIT[("health_waivers: Timestamp PAR-Q+, Risposte e Manleva Medico-Legale")]:::db
        END_HUB_LINK(["Collegamento Diretto: Hub Cockpit Centrale (Sezione 2)"]):::startend
    end

    %% Flusso Login
    START --> SPLASH --> AUTH_FORK
    AUTH_FORK -- "SÌ (Login)" --> LOGIN_VIEW --> LOGIN_SEC --> GW_AUTH_VALIDATE
    GW_AUTH_VALIDATE --> GW_JWT_EMIT --> COCKPIT_READY

    %% Flusso Registrazione Anti-Frode
    AUTH_FORK -- "NO (Registrazione B2C)" --> REG_STEP1 --> GW_BOT_FILTER
    GW_BOT_FILTER -- "Bot Rilevato" --> ERR_AGE
    GW_BOT_FILTER -- "Umano Verificato" --> GW_RATE_LIMIT
    GW_RATE_LIMIT --> REG_STEP2 --> AGE_GATE

    AGE_GATE -- "Mancanti" --> ERR_AGE --> REG_STEP2
    AGE_GATE -- "18+ Accettato" --> REG_STEP3 --> GW_PARQ_AUDIT
    GW_PARQ_AUDIT --> PARQ_GATE

    PARQ_GATE -- "SÌ (Red Flags)" --> PARQ_ALERT --> SRV_TRIAGE_FILTER
    PARQ_GATE -- "NO (Idoneo)" --> PARQ_OK --> SRV_BMR_CALC

    SRV_TRIAGE_FILTER --> REG_STEP4
    SRV_BMR_CALC --> REG_STEP4

    REG_STEP4 --> SRV_PROVISION_B2C --> DB_USERS --> DB_PROFILES --> DB_HEALTH_AUDIT --> GW_JWT_EMIT
    GW_JWT_EMIT --> SOCIAL_GATE

    SOCIAL_GATE -- "SÌ (Post Community)" --> STEP_UP_SMS --> GW_STEP_UP_VERIFY --> COCKPIT_READY
    SOCIAL_GATE -- "Solo Allenamento" --> COCKPIT_READY

    COCKPIT_READY --> NAV_HUB --> END_HUB_LINK

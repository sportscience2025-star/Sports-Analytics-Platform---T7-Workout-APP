flowchart TD
    classDef startend fill:#0f766e,stroke:#14b8a6,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    TITLE["SOFTWARE 1 (B2C CONSUMER) - FLOW 4A: DATA ANALISI - REVISIONE BIOMECCANICA ANGOLI PRINCIPALI"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (GONIOMETRO DIGITALE DETERMINISTICO)"]
        START(["Inizio: Revisione Biomeccanica Movimento"]):::startend
        LOAD_MEDIA["Caricamento Video o Freeze Frame Corsa/Esercizio (Buffer Locale)"]:::client
        MARKER_SELECT["Posizionamento Manuale Marker Articolari Principali (Anca, Ginocchio, Caviglia)"]:::client
        RENDER_GONIOMETER["Rendering Overlay Goniometrico & Gradi Misurati su Canvas 2D"]:::client
        ERR_ALIGN["Avviso: 'Punti non validi: riposiziona i marker sulle articolazioni'"]:::error
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & RBAC ISOLATION"]
        GW_INGEST["Ricezione Calcolo: POST /api/v1/analysis/angles-calculate"]:::gateway
        GW_RBAC_CHECK{"Validazione RBAC Tier 1 (Enforce: NO AI, NO RAG, 0 Wearable)?"}:::decision
        GW_BLOCK["HTTP 403 Forbidden: Funzionalita AI/RAG non permesse in Tier 1"]:::error
    end

    subgraph LANE_SERVER["CORSIA 3: SERVER SCATOLA NERA (GEOMETRIC KINEMATICS ENGINE)"]
        SRV_VEC_BUILD["Costruzione Vettori Cartesiani 2D dai Punti Segmentali"]:::server
        DEC_DEGENERATE{"Vettori Validi e Non Coincidenti?"}:::decision
        SRV_DOT_PRODUCT["Calcolo Trigonometrico Deterministico Angoli Principali (Dot Product)"]:::server
    end

    subgraph LANE_DB["CORSIA 4: DATABASE SILO 1 (CONSUMER DATA ARCHIVE)"]
        DB_PERSIST[("Salvataggio Opzionale Storico Personale in Silo 1 (athlete_biomechanics_angles)")]:::db
        END_FLOW(["Fine: Misurazione Angolare Visualizzata (Zero AI / Zero Scheda Sync)"]):::startend
    end

    %% Connessioni di flusso
    START --> LOAD_MEDIA --> MARKER_SELECT
    MARKER_SELECT --> GW_INGEST
    GW_INGEST --> GW_RBAC_CHECK
    GW_RBAC_CHECK -- No / Parametri Vietati --> GW_BLOCK --> ERR_ALIGN
    GW_RBAC_CHECK -- Si / Valido Tier 1 --> SRV_VEC_BUILD
    SRV_VEC_BUILD --> DEC_DEGENERATE
    DEC_DEGENERATE -- Punti Sovrapposti --> ERR_ALIGN
    DEC_DEGENERATE -- Punti Validi --> SRV_DOT_PRODUCT
    SRV_DOT_PRODUCT --> DB_PERSIST
    DB_PERSIST --> RENDER_GONIOMETER --> END_FLOW

flowchart TD
    classDef startend fill:#0f766e,stroke:#14b8a6,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    TITLE["SOFTWARE 1 (B2C CONSUMER) - FLOW 2A: PERSONAL ATHLETE COCKPIT & DIARY"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (MOBILE PWA)"]
        START(["Inizio: Accesso alla Home Cockpit"]):::startend
        COCKPIT_RENDER["Rendering Cockpit: Scheda Allenamento Oggi + Widget Readiness"]:::client
        WIDGET_STREAK["Visualizzazione Streak Giorni Consecutivi & Badge Costanza"]:::client
        CALENDAR_VIEW["Calendario Mensile Storico Sessioni Completate"]:::client
        BTN_START_WORKOUT["Pulsante CTA 'Avvia Allenamento di Oggi'"]:::client
        ERR_BANNER["Banner Disconnessione: Modalita Offline Attiva (Local Cache)"]:::error
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & FEATURE GATING"]
        GW_FETCH["Ricezione GET /api/v1/cockpit/athlete/today"]:::gateway
        GW_AUTH{"JWT Tier 1 Valido?"}:::decision
        GW_CACHE{"Dati in Edge Cache (Redis)?"}:::decision
        GW_REJECT["HTTP 401 Unauthorized / Re-login"]:::error
    end

    subgraph LANE_SERVER["CORSIA 3: SERVER SCATOLA NERA (READINESS & DIARY ENGINE)"]
        SRV_SCHEDULE["Risoluzione Scheda Odierna da Piano Attivo"]:::server
        SRV_READINESS["Algoritmo Calcolo Readiness (basato su RPE ieri + sonno se presente)"]:::server
        SRV_STREAK["Verifica Continuita Streak e Assegnazione Gamification Points"]:::server
    end

    subgraph LANE_DB["CORSIA 4: DATABASE SILO 1 (CONSUMER RELATIONAL)"]
        DB_QUERY[("Query Silo 1: athlete_workouts, completion_logs, streaks")]:::db
        END_READY(["Fine: Cockpit Interattivo Pronto per l'Atleta"]):::startend
    end

    %% Flussi
    START --> COCKPIT_RENDER
    COCKPIT_RENDER --> GW_FETCH
    GW_FETCH --> GW_AUTH
    GW_AUTH -- No --> GW_REJECT --> ERR_BANNER
    GW_AUTH -- Si --> GW_CACHE
    GW_CACHE -- Cache Hit --> COCKPIT_RENDER
    GW_CACHE -- Cache Miss --> SRV_SCHEDULE

    SRV_SCHEDULE --> DB_QUERY
    DB_QUERY --> SRV_READINESS --> SRV_STREAK
    SRV_STREAK --> WIDGET_STREAK
    SRV_SCHEDULE --> CALENDAR_VIEW
    SRV_SCHEDULE --> BTN_START_WORKOUT
    BTN_START_WORKOUT --> END_READY

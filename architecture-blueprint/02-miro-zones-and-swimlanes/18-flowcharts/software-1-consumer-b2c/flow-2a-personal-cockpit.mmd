    TITLE["SOFTWARE 1 (B2C CONSUMER) - FLOW 2A: CATALOGO ESERCIZI & AVATAR 3D"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (REACT 18 & THREE.JS DRACO)"]
        T1_START(["Inizio: Home Cockpit - Accesso Catalogo Esercizi"]):::startend
        T1_DEC_SEARCH_MODE{"Modalita di Ricerca Utente?"}:::decision
        T1_UI_FILTER_SECTION["Navigazione Filtrata per Sezioni (Muscolo, Distretto, Categoria)"]:::client
        T1_UI_TEXT_SEARCH["Ricerca Testuale Full-Text Istantanea (Debounce 250ms)"]:::client
        T1_DEC_RESULTS{"Esito Filtri & Ricerca Catalogo?"}:::decision
        T1_UI_GRID_POPULATED["Rendering Griglia Esercizi Catalogo Base (328 Esercizi)"]:::client
        T1_UI_EMPTY_STATE["Empty State & Suggerimenti di Ricerca"]:::error
        T1_DEC_SELECT_EXERCISE{"Supporto WebGL 2.0 & GPU 3D Attivo?"}:::decision
        T1_UI_FALLBACK_2D["Graceful Degradation: Video 2D Pre-Renderizzato MP4 60fps"]:::error
        T1_UI_VIEWER_3D["Visualizzazione 3D Interattiva: Orbit 360°, Fasce Muscolari (Rosso/Giallo/Ciano)"]:::client

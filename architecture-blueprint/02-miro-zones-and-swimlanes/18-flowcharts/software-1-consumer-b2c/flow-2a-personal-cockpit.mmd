    end

    subgraph LANE_DB["CORSIA 4: DATABASE TRIPARTITO (SILO 1 - CONSUMER POSTGRESQL)"]
        T1_DB_QUERY_SILO1[("Database Silo 1: catalog_exercises (328 record)")]:::db
        T1_DB_FAV_WRITE[("Database Silo 1: user_favorites (Preferiti Utente)")]:::db
    end

    %% Connessioni del Flusso
    T1_START --> T1_UI_POLICY_CHECK
    T1_UI_POLICY_CHECK --> T1_DEC_SEARCH_MODE
    T1_DEC_SEARCH_MODE -- "Sezioni Specifiche" --> T1_UI_FILTER_SECTION
    T1_DEC_SEARCH_MODE -- "Ricerca Testuale" --> T1_UI_TEXT_SEARCH
    T1_UI_FILTER_SECTION --> T1_GW_CATALOG_QUERY
    T1_UI_TEXT_SEARCH --> T1_GW_CATALOG_QUERY
    T1_GW_CATALOG_QUERY -- "Cache Hit" --> T1_DEC_RESULTS
    T1_GW_CATALOG_QUERY -- "Cache Miss" --> T1_DB_QUERY_SILO1 --> T1_DEC_RESULTS
    T1_DEC_RESULTS -- "Match Trovati" --> T1_UI_GRID_POPULATED
    T1_DEC_RESULTS -- "Zero Risultati" --> T1_UI_EMPTY_STATE
    T1_UI_EMPTY_STATE -. "Reset Filtri" .-> T1_UI_GRID_POPULATED
    T1_UI_GRID_POPULATED --> T1_DEC_SELECT_EXERCISE
    T1_DEC_SELECT_EXERCISE -- "SÌ: WebGL 3D" --> T1_SRV_3D_DRACO --> T1_UI_VIEWER_3D
    T1_DEC_SELECT_EXERCISE -- "NO: Fallback 2D" --> T1_UI_FALLBACK_2D --> T1_UI_VIEWER_3D
    T1_UI_VIEWER_3D --> T1_UI_TECH_CONTENT
    T1_UI_TECH_CONTENT --> T1_DEC_USER_ACTION
    T1_DEC_USER_ACTION -- "Tenta Modifica/Upload" --> T1_DEC_MOD_CHECK
    T1_DEC_MOD_CHECK -- "Blocco Enforced" --> T1_UI_POLICY_BLOCK --> T1_END_READY
    T1_DEC_USER_ACTION -- "Salva nei Preferiti" --> T1_GW_FAV_SAVE --> T1_DB_FAV_WRITE --> T1_END_READY
    T1_DEC_USER_ACTION -- "Avvia Workout" --> T1_TRANSITION_PLAYER --> T1_END_READY

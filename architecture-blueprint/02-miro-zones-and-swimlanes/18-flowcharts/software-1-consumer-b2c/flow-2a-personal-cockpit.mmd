    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1.5px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1.5px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1.5px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;

    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & RBAC FEATURE GATING TIER 1"]
        T1_UI_POLICY_CHECK["API Gateway: Verifica Gating Tier 1 (Libreria Standard)"]:::gateway
        T1_GW_CATALOG_QUERY["API Gateway: GET /api/v1/catalog/exercises (Cache Redis)"]:::gateway
        T1_DEC_MOD_CHECK{"Richiesta Modifica o Upload Video Proprio?"}:::decision
        T1_GW_FAV_SAVE["API Gateway: POST /api/v1/user/favorites"]:::gateway

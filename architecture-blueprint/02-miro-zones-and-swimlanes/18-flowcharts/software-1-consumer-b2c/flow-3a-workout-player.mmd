flowchart TD
    classDef startend fill:#0f766e,stroke:#14b8a6,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    TITLE["SOFTWARE 1 (B2C CONSUMER) - FLOW 3A: PROGRAMMAZIONE BASE, SCHEDE PRE-CONFEZIONATE, WORKOUT PLAYER & CONDIVISIONE TOGETHER SOCIAL"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (SCHEDE PRE-CONFEZIONATE, GYM PLAYER & TOGETHER SOCIAL)"]
        START(["Inizio: Accesso Sezione Programmi (App Utente)"]):::startend
        UI_SEARCH_FILTER["Barra di Ricerca & Filtri per Sport, Categoria e Obiettivo"]:::client
        DEC_CAT{"Scelta Tipologia Scheda?"}:::decision
        UI_PRESETS["Consultazione Schede Pre-Confezionate (Parametri Standardizzati)"]:::client
        UI_REHAB["Catalogo Programmi Generici di Riabilitazione"]:::client
        UI_VIEW["Visualizzazione In-App Scheda & Spiegazione AI Generica"]:::client
        DEC_ACTION{"Azione Utente: Avvia Sessione vs Esporta PDF?"}:::decision
        UI_START_SESSION["Pulsante 'Avvia Sessione' (Scheda Giorno o Workout Libero)"]:::client
        UI_GYM_PLAYER["Interfaccia da Palestra (Workout Session Tracker): Timer Recupero, Check Serie, Carichi (kg) & Reps Effettive"]:::client
        UI_TOGETHER_SHARE["Condivisione su Together Social: Card Dati Generici Allenamento (Durata, Volume, Esercizi)"]:::client
        UI_DOWNLOAD_PDF["Download Scheda in Formato PDF Read-Only (Non Modificabile)"]:::client
        UI_GATING_BANNER["Banner Vincoli: Modifica parametri, anamnesi & fonti riservati a Tier 2/3"]:::error
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & RBAC FEATURE GATING"]
        GW_GATING_CHECK["Verifica Permessi Tier 1: Blocco Data Analysis & Parametri Fissi"]:::gateway
        GW_FETCH_REQ["Ricezione GET /api/v1/programs/presets"]:::gateway
        GW_LOG_REQ["Ricezione POST /api/v1/programs/sessions/log"]:::gateway
        GW_SOCIAL_REQ["Ricezione POST /api/v1/social/together/share"]:::gateway
        GW_PDF_REQ["Ricezione POST /api/v1/programs/presets/:id/export-pdf"]:::gateway
    end

    subgraph LANE_SERVER["CORSIA 3: SERVER SCATOLA NERA (PRESET ENGINE, WORKOUT LOGGER & PDF COMPILER)"]
        SRV_PRESET_FILTER["Preset Engine: Selezione Schede Standardizzate per Categoria"]:::server
        SRV_AI_EXPLAIN["AI Generica: Spiegazione Scopo & Utilità Scheda (No Citazioni)"]:::server
        SRV_LOG_SESSION["Workout Logger: Calcolo Durata, Volume Totale/Tonnellaggio & Generazione Card Social"]:::server
        SRV_PDF_RENDER["PDF Renderer: Generazione Documento Statico Locked (protected:true)"]:::server
    end

    subgraph LANE_DB["CORSIA 4: DATABASE SILO 1 (CONSUMER RELATIONAL PRESETS & WORKOUT SESSIONS)"]
        DB_FETCH_PRESETS[("Lettura Schede Pre-Confezionate da Silo 1 (preset_programs)")]:::db
        DB_LOG_WORKOUT[("Registrazione Sessione Silo 1 (workout_sessions)")]:::db
        END_READY(["Fine: Sessione Registrata / Together Social o PDF Esportato"]):::startend
    end

    %% Connessioni del Flusso
    START --> UI_SEARCH_FILTER --> DEC_CAT
    DEC_CAT -- Allenamento Standard --> UI_PRESETS
    DEC_CAT -- Riabilitazione Generica --> UI_REHAB

    UI_PRESETS --> GW_FETCH_REQ
    UI_REHAB --> GW_FETCH_REQ
    GW_FETCH_REQ --> GW_GATING_CHECK --> SRV_PRESET_FILTER --> DB_FETCH_PRESETS
    DB_FETCH_PRESETS --> UI_VIEW --> SRV_AI_EXPLAIN --> DEC_ACTION

    DEC_ACTION -- Avvia Sessione --> UI_START_SESSION --> UI_GYM_PLAYER --> GW_LOG_REQ --> SRV_LOG_SESSION
    SRV_LOG_SESSION --> DB_LOG_WORKOUT --> GW_SOCIAL_REQ --> UI_TOGETHER_SHARE --> UI_GATING_BANNER --> END_READY

    DEC_ACTION -- Esporta PDF --> GW_PDF_REQ --> SRV_PDF_RENDER --> UI_DOWNLOAD_PDF --> UI_GATING_BANNER --> END_READY

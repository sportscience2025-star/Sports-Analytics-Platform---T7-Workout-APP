flowchart TD
    classDef startend fill:#0f766e,stroke:#14b8a6,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    TITLE["SOFTWARE 1 (B2C CONSUMER) - FLOW 6A: MOVELY DESK-CARE & ACTIVE MICRO-PAUSES"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (DESK-CARE)"]
        START(["Inizio: Timer Sedentarieta Attivo"]):::startend
        TIMER_TRIGGER{"Rilevati 50 minuti di sedentarieta / lavoro?"}:::decision
        NOTIF_PROMPT["Notifica Push: 'E ora di una pausa attiva di 2 minuti!'"]:::client
        MODAL_EXERCISES["Schermata Movely: 3 Micro-Esercizi Scrivania (Cervicale, Spalle, Lombare)"]:::client
        TIMER_2MIN["Timer Guidato 120s con Animazione Postura"]:::client
        BTN_DONE["Pulsante 'Pausa Completata'"]:::client
        STREAK_POPUP["Popup: 'Ottimo! Streak Posturale Giornaliero: +1'"]:::client
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & LOG SYNC"]
        GW_SYNC["Ricezione POST /api/v1/deskcare/complete-break"]:::gateway
        GW_CHECK_TIER{"Abbonamento Consumer Tier 1 Attivo?"}:::decision
    end

    subgraph LANE_SERVER["CORSIA 3: SERVER SCATOLA NERA (POSTURAL HEALTH ENGINE)"]
        SRV_ROTATE["Rotazione Algoritmica Routine Micro-Pause (Prevenzione Sovraccarico)"]:::server
        SRV_POSTURE_SCORE["Calcolo Indice Benessere Posturale Giornaliero"]:::server
    end

    subgraph LANE_DB["CORSIA 4: DATABASE SILO 1 (CONSUMER WELLNESS)"]
        DB_SAVE_BREAK[("Scrittura Silo 1: deskcare_logs, postural_streaks")]:::db
        END_CARE(["Fine: Micro-Pausa Registrata"]):::startend
    end

    %% Flussi
    START --> TIMER_TRIGGER
    TIMER_TRIGGER -- No --> START
    TIMER_TRIGGER -- Si --> NOTIF_PROMPT --> MODAL_EXERCISES
    MODAL_EXERCISES --> TIMER_2MIN --> BTN_DONE
    BTN_DONE --> GW_SYNC --> GW_CHECK_TIER
    GW_CHECK_TIER -- Valido --> SRV_ROTATE --> SRV_POSTURE_SCORE
    SRV_POSTURE_SCORE --> DB_SAVE_BREAK --> STREAK_POPUP --> END_CARE

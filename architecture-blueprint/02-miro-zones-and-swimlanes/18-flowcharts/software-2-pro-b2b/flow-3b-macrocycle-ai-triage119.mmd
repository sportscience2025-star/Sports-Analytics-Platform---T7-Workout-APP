flowchart TD
    classDef startend fill:#0f766e,stroke:#14b8a6,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    TITLE["SOFTWARE 2 (B2B PRO P.IVA) - FLOW 3B: PROGRAMMAZIONE ANAMNESTICA 6M, RTP, AI FONTI & MULTI-EXPORT"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (PRO PROGRAMMING COCKPIT)"]
        START(["Inizio: Cockpit Programmazione Pro P.IVA"]):::startend
        DEC_SOURCE{"Modalità di Partenza Programma?"}:::decision
        UI_SPORT_ARCHIVE["Archivio Schede Pre-Confezionate per Disciplina Sportiva"]:::client
        UI_ANAMNESIS["Questionario Anamnestico Completo: Storia Clinica & Caratteristiche"]:::client
        DEC_PATH_TYPE{"Tipologia Percorso Atleta?"}:::decision
        UI_REHAB_RTP["Modulo Riabilitazione Specifica & Protocolli Return to Play (RTP)"]:::client
        UI_PERIOD_WIZARD["Wizard Periodizzazione a Medio Termine (Fino a 6 Mesi / Micro-Meso-Macro)"]:::client
        UI_PARAM_EDITOR["Editor Completo Parametri: Modifica Serie, Reps, Carichi, Recuperi & Swap"]:::client
        UI_AI_SCIENCE["Pannello AI Fonti: Spiegazione con Bibliografia, DOI e Link + Info Esercizi"]:::client
        DEC_EXPORT_HUB{"Selezione Formato Esportazione?"}:::decision
        UI_EXPORT_DOCS["Download Documento: PDF, Excel (.xlsx sbloccato), Word (.docx), Notes"]:::client
        UI_RESTRICTION_CARD["Banner Vincoli: No Video in scheda, No Chatbot 24/7, No RAG, No Data Analysis"]:::error
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & RBAC PRO"]
        GW_AUTH_PRO["Validazione JWT Tier 2 Pro (P.IVA Attiva) & Verifica Orizzonte <= 6 Mesi"]:::gateway
        GW_POST_PROGRAM["Ricezione POST /api/v1/pro/programs/generate"]:::gateway
        GW_EXPORT_REQ["Ricezione POST /api/v1/pro/programs/:id/export"]:::gateway
    end

    subgraph LANE_SERVER["CORSIA 3: SERVER SCATOLA NERA (ANAMNESIS, 6M ENGINE & MULTI-EXPORTER)"]
        SRV_ANAMNESIS_CALC["Clinical Anamnesis Processor: Filtro Esercizi & Asimmetrie"]:::server
        SRV_PERIODIZER["Periodization Engine: Calcolo Modelli DUP / Blocchi / Lineare fino a 24 Settimane"]:::server
        SRV_AI_CITATION["Scientific AI Engine: Retrieval Citazioni Accademiche (DOI/PubMed) & Schede"]:::server
        SRV_MULTI_FORMAT["Multi-Format Compiler: Rendering Openpyxl (.xlsx), docx, PDFKit & Notes"]:::server
    end

    subgraph LANE_DB["CORSIA 4: DATABASE SILO 1 (PRO PROGRAMMING & ANAMNESIS)"]
        DB_QUERY_EXERCISES[("Lettura Catalogo Esercizi & Matrici Cliniche")]:::db
        DB_SAVE_MACRO[("Salvataggio Scheda Personalizzata su Silo 1 Pro (pro_macrocycles)")]:::db
        END_EXPORTED(["Fine: Scheda 6 Mesi Attiva & Esportata nei 4 Formati"]):::startend
    end

    %% Flussi di Connessione
    START --> DEC_SOURCE
    DEC_SOURCE -- Archivio Sport --> UI_SPORT_ARCHIVE
    DEC_SOURCE -- Questionario Anamnestico --> UI_ANAMNESIS

    UI_SPORT_ARCHIVE --> DEC_PATH_TYPE
    UI_ANAMNESIS --> DEC_PATH_TYPE

    DEC_PATH_TYPE -- Riabilitazione & RTP --> UI_REHAB_RTP
    DEC_PATH_TYPE -- Performance / Forza --> UI_PERIOD_WIZARD

    UI_REHAB_RTP --> GW_POST_PROGRAM
    UI_PERIOD_WIZARD --> GW_POST_PROGRAM

    GW_POST_PROGRAM --> GW_AUTH_PRO --> SRV_ANAMNESIS_CALC --> SRV_PERIODIZER
    SRV_PERIODIZER --> DB_QUERY_EXERCISES --> DB_SAVE_MACRO
    DB_SAVE_MACRO --> UI_PARAM_EDITOR

    UI_PARAM_EDITOR --> UI_AI_SCIENCE --> SRV_AI_CITATION --> DEC_EXPORT_HUB
    DEC_EXPORT_HUB -- Esporta Multi-Formato --> GW_EXPORT_REQ --> SRV_MULTI_FORMAT --> UI_EXPORT_DOCS
    UI_EXPORT_DOCS --> UI_RESTRICTION_CARD --> END_EXPORTED

flowchart TD
    classDef startend fill:#0f766e,stroke:#14b8a6,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    TITLE["SOFTWARE 2 (B2B PRO P.IVA) - FLOW 4B: DATA ANALISI - BIOMECCANICA AI 70%, LIVE CAMERA & WEARABLE T7"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (LIVE CAMERA & POSE CORRECTION)"]
        START(["Inizio: Setup Analisi Biomeccanica Pro"]):::startend
        BLE_SCAN["Connessione Wearable Marchio T7 (Web Bluetooth API)"]:::client
        CAM_START["Attivazione Fotocamera Live Stream 1080p a 60fps"]:::client
        OVERLAY_RENDER["Overlay Scheletrico 2D: Angoli Principali e Specifici (Valgismo, Tilt, Asimmetrie)"]:::client
        LIVE_ALERT_BOX["Box Correzione Real-Time: 'Allinea ginocchio destro: correggi valgismo'"]:::client
        SHARE_MODAL["Selezione Condivisione 1:1 con Singolo Atleta"]:::client
        ERR_DEV["Notifica: 'Dispositivo non supportato: connetti wearable ufficiale T7'"]:::error
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & ISOLAMENTO CATALOGO"]
        GW_INGEST_STREAM["Streaming Ingestion: POST /api/v1/pro/analysis/live-stream"]:::gateway
        GW_CHECK_T7{"Verifica Hardware T7 & Destinazione DB Data Analisi?"}:::decision
        GW_BLOCK_NON_T7["HTTP 403 Forbidden: Wearable non T7 o Tentativo Scrittura nel Catalogo"]:::error
    end

    subgraph LANE_SERVER["CORSIA 3: SERVER SCATOLA NERA (AI 70% & T7 SENSOR PARSER)"]
        SRV_AI_70["Modello AI Interno T7 (Inferenza 70%): Calcolo Angoli Specifici & Note"]:::server
        DEC_CORRECTION{"Rilevata Deviazione Posturale nell'Esercizio?"}:::decision
        SRV_GEN_CORRECTION["Generazione Feedback Correttivo sul Momento"]:::server
        SRV_LACTATE_PARSER["Parser Telemetrico T7: Analisi Sommaria Soglie Lattato"]:::server
    end

    subgraph LANE_DB["CORSIA 4: DATABASE SILO 1 (PRO DATA ANALYSIS ARCHIVE)"]
        DB_STORE_ANALYSIS[("Salvataggio Video e Trascrizioni in DB Data Analisi (Separato dal Catalogo)")]:::db
        END_PRO(["Fine: Sessione Archiviata in Data Analisi e Condivisa 1:1"]):::startend
    end

    %% Connessioni di flusso
    START --> BLE_SCAN --> CAM_START
    CAM_START --> GW_INGEST_STREAM
    GW_INGEST_STREAM --> GW_CHECK_T7
    GW_CHECK_T7 -- No / Dispositivo Terzo o Scrittura Catalogo --> GW_BLOCK_NON_T7 --> ERR_DEV
    GW_CHECK_T7 -- Si / Valido T7 e DB Data Analisi --> SRV_AI_70
    SRV_AI_70 --> DEC_CORRECTION
    DEC_CORRECTION -- Si / Anomalia Rilevata --> SRV_GEN_CORRECTION --> LIVE_ALERT_BOX
    DEC_CORRECTION -- No / Esecuzione Corretta --> OVERLAY_RENDER
    LIVE_ALERT_BOX --> OVERLAY_RENDER
    SRV_AI_70 --> SRV_LACTATE_PARSER
    OVERLAY_RENDER --> DB_STORE_ANALYSIS
    SRV_LACTATE_PARSER --> DB_STORE_ANALYSIS
    DB_STORE_ANALYSIS --> SHARE_MODAL --> END_PRO

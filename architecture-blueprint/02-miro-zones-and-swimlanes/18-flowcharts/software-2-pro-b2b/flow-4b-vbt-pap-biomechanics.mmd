flowchart TD
    classDef startend fill:#0f766e,stroke:#14b8a6,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    TITLE["SOFTWARE 2 (B2B PRO P.IVA) - FLOW 4B: BIOMECHANICAL VBT & PAP JUMP ANALYSIS"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (BIOMECHANICS DASHBOARD)"]
        START(["Inizio: Setup Test Biomeccanico"]):::startend
        BLE_CONNECT["Connessione Web Bluetooth BLE: Encoder Vitruve / Piattaforma Salti"]:::client
        TEST_CHOICE{"Tipologia Test"}:::decision
        VBT_EXEC["Esecuzione VBT: 4 Serie Incrementali (Panca/Squat) a Massima Intenzione"]:::client
        PAP_EXEC["Protocollo PAP: Baseline CMJ -> Carico Condizionante -> Salti Post-PAP (4', 8', 12')"]:::client
        CHART_RENDER["Rendering Chart.js: Profilo F-V, Curva Potenza e Trend Esplosivita PAP"]:::client
        OUTLIER_ALERT["Notifica: 'Ripetizione scartata per anomalia di traiettoria (MAD > 3)'"]:::error
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & STREAMING INGESTION"]
        GW_STREAM["Ricezione Stream Dati BLE: POST /api/v1/pro/biomechanics/stream"]:::gateway
        GW_VALIDATE_STREAM{"Integrita Frame Dati (Campionamento >= 100Hz)?"}:::decision
    end

    subgraph LANE_SERVER["CORSIA 3: SERVER SCATOLA NERA (PHYSICS & REGRESSION ENGINE)"]
        SRV_MAD_FILTER["Filtro Robusto Outlier MAD (Median Absolute Deviation)"]:::server
        SRV_HYBRID_FIT["Regressione Ibrida: Confronto Lineare vs Polinomiale (Selezione AIC / R2_adj)"]:::server
        SRV_METRICS["Calcolo V0 (m/s), F0 (N), Pmax (W) e Stima 1RM con Intervallo Confidenza 95%"]:::server
        SRV_PAP_STATS["Motore PAP Stats: Student's t-test, Cohen's d e Verifica Soglia Clinica MDC 95%"]:::server
    end

    subgraph LANE_DB["CORSIA 4: DATABASE SILO 1 (PRO BIOMECHANICS ARCHIVE)"]
        DB_WRITE_VBT[("Salvataggio Serie VBT e Parametri Meccanici in Silo 1 (vbt_trials)")]:::db
        DB_WRITE_PAP[("Salvataggio Curve PAP e Risposta Neuromuscolare in Silo 1 (pap_tests)")]:::db
        END_BIOMEC(["Fine: Report Biomeccanico Validato e Archiviato"]):::startend
    end

    %% Flussi
    START --> BLE_CONNECT --> TEST_CHOICE
    TEST_CHOICE -- Velocity Based Training --> VBT_EXEC
    TEST_CHOICE -- Post-Activation Potentiation --> PAP_EXEC

    VBT_EXEC --> GW_STREAM
    PAP_EXEC --> GW_STREAM
    GW_STREAM --> GW_VALIDATE_STREAM
    GW_VALIDATE_STREAM -- Dati Corrotti --> OUTLIER_ALERT
    GW_VALIDATE_STREAM -- Validi --> SRV_MAD_FILTER

    SRV_MAD_FILTER --> SRV_HYBRID_FIT --> SRV_METRICS --> DB_WRITE_VBT
    SRV_MAD_FILTER --> SRV_PAP_STATS --> DB_WRITE_PAP

    DB_WRITE_VBT --> CHART_RENDER
    DB_WRITE_PAP --> CHART_RENDER
    CHART_RENDER --> END_BIOMEC

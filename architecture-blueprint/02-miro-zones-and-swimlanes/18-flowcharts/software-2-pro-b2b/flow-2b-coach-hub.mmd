flowchart TD
    classDef startend fill:#0f766e,stroke:#14b8a6,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    TITLE["SOFTWARE 2 (B2B PRO P.IVA) - FLOW 2B: CATALOGO 3D, VIDEO IN-APP & REVISIONE AI"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (COACH & FISIO COCKPIT)"]
        START(["Inizio: Coach Cockpit - Accesso Sezione Catalogo"]):::startend
        DEC_MODE{"Seleziona Operazione nel Catalogo?"}:::decision
        
        %% Ramo 1: Consultazione & Prescrizione
        UI_SEARCH["Consultazione 328 Esercizi: Triage 119 Patologie & Filtri Clinici"]:::client
        DEC_SAFETY{"Verifica Compatibilita Clinica Atleta?"}:::decision
        GRID_PRO["Griglia Catalogo Pro: Miniature 3D, Badge Idoneita & Limitatore ROM"]:::client
        UI_ALERT["Alert Clinico: Incompatibilita Rilevata (3 Alternative Sicure)"]:::error
        VIEWER_3D["Visualizzatore 3D Pro: Orbit 360°, Fasce Attive & Blocco ROM Touch"]:::client
        UI_PRESCRIPTION["Prescrizione Scheda Atleta & Note Cliniche Personalizzate"]:::client
        
        %% Ramo 2: Video Recording In-App
        UI_CAM_RECORD["In-App Camera: Registrazione Video Atleta su Esercizio Personalizzato"]:::client
        UI_EDGE_POSE["Edge Computer Vision: Estrazione Keypoints 3D (MediaPipe 33 Landmark)"]:::client
        UI_DRAFT_FORM["Compilazione Bozza Coach: Punti Forza/Deboli, Errori Critici & Setup"]:::client
        DEC_AI_AUDIT{"Richiedere Revisione Coerente AI?"}:::decision
        UI_DIFF_MODAL["Modale Revisione Diff Sezione per Sezione: Approva / Modifica / Scarta Proposte AI"]:::client
        DEC_KEEP_VIDEO{"Conservare Video Grezzo o Solo 3D?"}:::decision
        VIEWER_TOGGLE["Scheda Esercizio Custom: Toggle 'Video Reale vs Avatar 3D Stilizzato'"]:::client
        
        %% Ramo 3: Creazione Manuale Solo-Testo
        UI_TEXT_CREATE["Creazione Manuale Solo-Testo: Form Descrittivo, Target Muscolare & Cues"]:::client
        
        END_READY(["Fine: Esercizio Custom Operativo nel Catalogo Coach"]):::startend
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & FEATURE GATING TIER 2"]
        GW_FETCH["API Gateway: GET /api/v1/pro/catalog/exercises (Validazione JWT Tier 2)"]:::gateway
        GW_AUTH_CREATE{"Controllo Abilitazione Creazione Esercizi (Gating Tier 2 SÌ / Tier 1 NO)?"}:::decision
        GW_AUDIT_REQ["API Gateway: POST /api/v1/pro/exercises/ai-audit"]:::gateway
        GW_SYNTH_REQ["API Gateway: POST /api/v1/pro/exercises/synthesize-3d"]:::gateway
        GW_SAVE_CUSTOM["API Gateway: POST /api/v1/pro/exercises/custom-save"]:::gateway
    end

    subgraph LANE_SERVER["CORSIA 3: SERVER SCATOLA NERA (MULTIMODAL RAG & 3D SYNTHESIS ENGINE)"]
        SRV_TRIAGE["Motore Clinico: Triage Patologie & Limitatore Goniometrico ROM"]:::server
        SRV_RAG_AUDIT["Multimodal RAG & Web Audit: Query 322 Paper, PubMed, Web & Video Benchmark"]:::server
        SRV_3D_SYNTH["Generatore Cinematico & Mesh 3D: Sintesi glTF/GLB Draco con Fasi & Muscoli Attivi"]:::server
    end

    subgraph LANE_DB["CORSIA 4: DATABASE SILO 2 (PRO TENANT DATA STORE)"]
        DB_CATALOG[("Query Silo 2: catalog_exercises + storico anamnesi atleta")]:::db
        DB_CUSTOM_SAVE[("Persistenza Silo 2: custom_exercises, video cloud criptato, mesh 3D e log revisioni")]:::db
    end

    %% Connessioni del Flusso
    START --> DEC_MODE
    
    %% Flusso Consultazione
    DEC_MODE -- "1. Consulta Catalogo" --> UI_SEARCH
    UI_SEARCH --> GW_FETCH --> DB_CATALOG --> DEC_SAFETY
    DEC_SAFETY -- "Compatibilita OK" --> GRID_PRO
    DEC_SAFETY -- "Rischio Sovraccarico" --> UI_ALERT -. "Sostituzione" .-> GRID_PRO
    GRID_PRO --> VIEWER_3D --> UI_PRESCRIPTION --> END_READY

    %% Flusso Registrazione Video In-App
    DEC_MODE -- "2. Registra Video Atleta" --> UI_CAM_RECORD
    UI_CAM_RECORD --> UI_EDGE_POSE --> UI_DRAFT_FORM
    UI_DRAFT_FORM --> DEC_AI_AUDIT
    
    DEC_AI_AUDIT -- "SÌ: Revisione AI" --> GW_AUDIT_REQ
    GW_AUDIT_REQ --> SRV_RAG_AUDIT
    SRV_RAG_AUDIT --> UI_DIFF_MODAL
    UI_DIFF_MODAL --> DEC_KEEP_VIDEO
    
    DEC_AI_AUDIT -- "NO: Mantieni Bozza" --> DEC_KEEP_VIDEO
    
    DEC_KEEP_VIDEO -- "Cloud Criptato" --> GW_SYNTH_REQ
    DEC_KEEP_VIDEO -- "Solo 3D (No Video)" --> GW_SYNTH_REQ
    
    GW_SYNTH_REQ --> SRV_3D_SYNTH --> GW_SAVE_CUSTOM --> DB_CUSTOM_SAVE
    DB_CUSTOM_SAVE --> VIEWER_TOGGLE --> END_READY

    %% Flusso Creazione Solo-Testo
    DEC_MODE -- "3. Nuovo Solo-Testo" --> UI_TEXT_CREATE
    UI_TEXT_CREATE --> GW_AUTH_CREATE
    GW_AUTH_CREATE -- "Tier 2 Valido" --> GW_SYNTH_REQ
    GW_AUTH_CREATE -- "Tier 1 Non Autorizzato" --> UI_ALERT

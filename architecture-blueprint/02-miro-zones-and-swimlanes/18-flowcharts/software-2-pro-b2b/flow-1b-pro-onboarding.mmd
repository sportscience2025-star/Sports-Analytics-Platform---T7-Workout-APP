flowchart TD
    classDef startend fill:#0f766e,stroke:#14b8a6,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;
    classDef verified fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d,font-weight:bold;

    TITLE["SOFTWARE 2 (B2B PRO P.IVA) - FLOW 1B: ONBOARDING & SETUP FISCALE ANTI-FRODE (T7 PRO)"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (PRO WEB & MOBILE)"]
        START(["Inizio: Accesso Professionista"]):::startend
        AUTH_FORK{"Account Esistente?"}:::decision
        LOGIN_VIEW["Login Sicuro: Passkey WebAuthn FIDO2 / Email + Password Argon2id"]:::client
        LOGIN_2FA["2FA Obbligatoria (TOTP Authenticator o SMS OTP)"]:::client
        
        REG_STEP1["Step 1: Credenziali Studio & Cloudflare Turnstile (Anti-Bot)"]:::client
        REG_STEP2["Step 2: Dati Fiscali (P.IVA 11 cifre, Codice Fiscale, SDI, Sede Legale)"]:::client
        ERR_VAT["Allarme: P.IVA Non Valida o Inesistente (Blocco Registrazione)"]:::error
        
        REG_STEP3["Step 3: Inserimento OTP PEC (Ricevuto su casella certificata aziendale)"]:::client
        ERR_PEC["Allarme Anti-Spoofing: Fallita Verifica Titolarità P.IVA (Blocco)"]:::error
        
        ROLE_FORK{"Qualifica Professionale?"}:::decision
        STEP4A_FISIO["Step 4A: N° Albo FNOFI/TSRM-PSTRP + Polizza RC Sanitaria"]:::client
        STEP4B_PT["Step 4B: Laurea Scienze Motorie (L-22/LM-67) / CONI + RC Sportiva"]:::client
        
        REG_STEP5["Step 5: Stripe Identity (Selfie 3D Liveness + CIE/Passaporto) & IBAN Studio"]:::client
        KYC_FORK{"Stato Validazione KYC?"}:::decision
        SANDBOX_VIEW["Accesso Immediato Coach Hub (Sandbox Mode: VBT/DUP di prova, inviti bloccati)"]:::client
        VERIFIED_BADGE["Profilo Verificato (Badge Blu Pro): Licenza Tier 2 Full & Incassi Attivi"]:::verified
        
        PRO_COCKPIT_READY["INGRESSO COACH HUB PRO: Roster Atleti, VBT Vitruve, DUP & Physio"]:::startend
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & SECURITY ENFORCEMENT"]
        GW_LOGIN_AUTH["Verifica Credenziali & Rate Limiting IP/ASN"]:::gateway
        GW_SESSION_ISSUE["Emissione JWT Tier 2 Pro (Role: R2 Coach / R3 Physio)"]:::gateway
        GW_VAT_CHECK{"Verifica Telematica VIES & Agenzia Entrate"}:::decision
        GW_PEC_LOOKUP["Query Registro Nazionale INI-PEC & Generazione OTP Due-Vie"]:::gateway
        GW_PEC_VERIFY{"Controllo OTP PEC?"}:::decision
        GW_ROLE_GATE["Clinical Feature Gating: Sblocco cli_01..32 solo per Albo Sanitario"]:::gateway
        GW_STRIPE_WEBHOOK["Webhook Ricezione Stato Stripe Identity & KYC Liveness"]:::gateway
    end

    subgraph LANE_SERVER["CORSIA 3: SERVER SCATOLA NERA (ANTI-SCAM & PRO TENANT ENGINE)"]
        SRV_ANTI_SPOOF["Motore Anti-Impersonazione & Anti-Card Laundering"]:::server
        SRV_TENANT_PROV["Provisioning Tenant Professionale Isolato Silo 1"]:::server
        SRV_ESCROW_INIT["Configurazione Rolling Reserve Stripe Connect (Trattenuta di Sicurezza)"]:::server
        SRV_QUOTA_INIT["Attivazione Quota Atleti & Link Invito Unico"]:::server
    end

    subgraph LANE_DB["CORSIA 4: DATABASE SILO 1 (PRO MULTI-TENANT PARTITION)"]
        DB_PRO_TENANTS[("Salvataggio Record Pro Cifrato (pro_tenants, studio_profiles)")]:::db
        DB_AUDIT_LOG[("Audit Log Immatricolazione Fiscale & Certificati Albo")]:::db
        DB_STRIPE_CONF[("Salvataggio Configurazione Stripe Connect (stripe_merchants)")]:::db
    end

    %% Flusso Login
    START --> AUTH_FORK
    AUTH_FORK -- "SÌ (Già Registrato)" --> LOGIN_VIEW --> LOGIN_2FA --> GW_LOGIN_AUTH
    GW_LOGIN_AUTH --> GW_SESSION_ISSUE --> PRO_COCKPIT_READY

    %% Flusso Registrazione Anti-Frode
    AUTH_FORK -- "NO (Nuovo Studio)" --> REG_STEP1 --> REG_STEP2 --> GW_VAT_CHECK
    GW_VAT_CHECK -- "Non Valida" --> ERR_VAT --> REG_STEP2
    GW_VAT_CHECK -- "Valida" --> GW_PEC_LOOKUP --> REG_STEP3 --> GW_PEC_VERIFY
    GW_PEC_VERIFY -- "Errato" --> ERR_PEC
    GW_PEC_VERIFY -- "Confermato" --> ROLE_FORK

    ROLE_FORK -- "Fisioterapista" --> STEP4A_FISIO --> GW_ROLE_GATE
    ROLE_FORK -- "Chinesiologo / PT" --> STEP4B_PT --> GW_ROLE_GATE

    GW_ROLE_GATE --> REG_STEP5 --> GW_STRIPE_WEBHOOK
    GW_STRIPE_WEBHOOK --> SRV_ANTI_SPOOF --> SRV_TENANT_PROV --> SRV_ESCROW_INIT --> SRV_QUOTA_INIT
    SRV_QUOTA_INIT --> DB_PRO_TENANTS --> DB_AUDIT_LOG --> DB_STRIPE_CONF

    DB_STRIPE_CONF --> KYC_FORK
    KYC_FORK -- "In Attesa KYC / Bozza" --> SANDBOX_VIEW --> PRO_COCKPIT_READY
    KYC_FORK -- "Approvato 100%" --> VERIFIED_BADGE --> PRO_COCKPIT_READY

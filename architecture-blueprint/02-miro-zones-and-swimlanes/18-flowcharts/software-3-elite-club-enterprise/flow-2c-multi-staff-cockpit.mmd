    UI_DIFF_PRO --> DEC_LIBRARY_TIER
    
    DEC_AI_AUDIT_PRO -- "NO: Procedi con Bozza" --> DEC_LIBRARY_TIER
    
    DEC_LIBRARY_TIER -- "Livello 1: Singolo Atleta" --> UI_LEVEL_ATHLETE
    DEC_LIBRARY_TIER -- "Livello 2: Libreria Club" --> UI_LEVEL_CLUB
    
    UI_LEVEL_ATHLETE --> GW_SYNTH_PRO
    UI_LEVEL_CLUB --> GW_SYNTH_PRO
    
    GW_SYNTH_PRO --> SRV_TWIN_SYNTH --> GW_KMS_SAVE --> DB_KMS_SAVE
    DB_KMS_SAVE --> VIEWER_TOGGLE_PRO --> DEC_ACTION


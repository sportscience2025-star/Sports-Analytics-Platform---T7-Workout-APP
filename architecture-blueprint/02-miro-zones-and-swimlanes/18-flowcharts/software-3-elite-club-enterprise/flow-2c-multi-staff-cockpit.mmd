    %% Connessioni del Flusso
    START --> DEC_MODE
    
    %% Ramo Consultazione
    DEC_MODE -- "1. Catalogo Rosa & RTP" --> UI_SEARCH_TEAM
    UI_SEARCH_TEAM --> GW_FETCH_PRO --> GW_AUTH_CHECK
    GW_AUTH_CHECK -- "Staff Autorizzato" --> DB_QUERY_PRO --> DEC_RISK
    DEC_RISK -- "Idoneita Verificata" --> GRID_ELITE
    DEC_RISK -- "Rischio Lesione (>1.5)" --> UI_ALERT_RTP -. "Esercizi Adattati" .-> GRID_ELITE
    GRID_ELITE --> VIEWER_3D_ELITE --> DEC_ACTION

    %% Ramo Registrazione Video In-App
    DEC_MODE -- "2. Registra Video Atleta" --> UI_CAM_CAPTURE
    UI_CAM_CAPTURE --> UI_MARKERLESS --> UI_STAFF_DRAFT

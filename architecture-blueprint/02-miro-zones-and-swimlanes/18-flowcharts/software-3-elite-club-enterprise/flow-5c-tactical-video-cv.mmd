flowchart TD
    classDef startend fill:#0f766e,stroke:#14b8a6,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:1px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a,font-weight:bold;
    classDef gateway fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#0f172a;
    classDef server fill:#d1fae5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef db fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    TITLE["SOFTWARE 3 (B2B ENTERPRISE) - FLOW 5C: CONFIDENTIAL TACTICAL VIDEO COMPUTER VISION (PITCH ANALYSIS)"]

    subgraph LANE_CLIENT["CORSIA 1: THIN CLIENT UI/UX (TACTICAL VIDEO SUITE)"]
        START(["Inizio: Caricamento Video Tattico Gara / Allenamento"]):::startend
        PLAYER_CANVAS["Player Video Multi-Camera Sincronizzato con Bounding Box Giocatori"]:::client
        METRIC_OVERLAY["Sovrimpressione Metriche Tattiche: Compattezza Squadra (m), Linee di Pressione, Baricentro"]:::client
        TAG_DRAWER["Strumento Tag Eventi: Transizioni Positive/Negative, Recuperi Palla, Duelli"]:::client
        EXPORT_REPORT_BTN["Pulsante 'Genera Dossier Tattico per lo Staff Tecnico'"]:::client
        CONFIDENTIAL_LOCK["Watermark Sicurezza Dinamico: 'STRETTAMENTE RISERVATO - NON DIFFONDIBILE'"]:::error
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & SECURE STREAMING"]
        GW_VIDEO_UPLOAD["Ricezione POST /api/v1/club/video/upload-tactical"]:::gateway
        GW_CHECK_INTERNAL{"Richiesta Proviene da Rete Interna Protetta del Club?"}:::decision
        GW_BLOCKED["Accesso Negato: Funzionalita Video Riservata e Senza Integrazioni Social"]:::error
    end

    subgraph LANE_SERVER["CORSIA 3: SERVER SCATOLA NERA (COMPUTER VISION & TACTICS ENGINE)"]
        SRV_CV_DETECTION["Computer Vision YOLO & Pose Estimation: Rilevamento Coordinate (X,Y) Giocatori sul Campo"]:::server
        SRV_HOMOGRAPHY["Trasformazione Omografica: Proiezione da Vista Prospettica Telecamera a Piano 2D del Campo"]:::server
        SRV_VORONOI["Calcolo Diagrammi di Voronoi: Spazi Dominati e Superficie Utile Occupata"]:::server
    end

    subgraph LANE_DB["CORSIA 4: DATABASE SILO 2 (BUNKER CLUB KMS ENCLAVE)"]
        DB_WRITE_COORDS[("Salvataggio Coordinate Tracciamento sul Campo in Silo 2 (tactical_coordinates)")]:::db
        DB_WRITE_TAGS[("Salvataggio Tag Tattici e Clip Correlate in Silo 2 (match_tactical_events)")]:::db
        END_TACTICAL_DONE(["Fine: Analisi Tattico-Biomeccanica Archiviata nel Bunker"]):::startend
    end

    %% Flussi
    START --> GW_VIDEO_UPLOAD --> GW_CHECK_INTERNAL
    GW_CHECK_INTERNAL -- Esterna Non Protetta --> GW_BLOCKED
    GW_CHECK_INTERNAL -- Rete Protetta Club --> SRV_CV_DETECTION

    SRV_CV_DETECTION --> SRV_HOMOGRAPHY --> SRV_VORONOI
    SRV_VORONOI --> DB_WRITE_COORDS
    SRV_VORONOI --> DB_WRITE_TAGS

    DB_WRITE_COORDS --> PLAYER_CANVAS --> METRIC_OVERLAY
    DB_WRITE_TAGS --> TAG_DRAWER --> EXPORT_REPORT_BTN
    CONFIDENTIAL_LOCK -. Sempre Attivo su .-> PLAYER_CANVAS

    EXPORT_REPORT_BTN --> END_TACTICAL_DONE

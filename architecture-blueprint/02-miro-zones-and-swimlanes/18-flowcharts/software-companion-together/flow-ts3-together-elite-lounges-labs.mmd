        UI_VIP_LOUNGES["VIP & Elite Lounges Blindate: Stanze Riservate Club Serie A/Eurolega"]:::client
        UI_LAB_BOOKING["Vetrina & Booking Laboratori: Prenotazione Oraria Macchinari Avanzati"]:::client
        UI_STAFF_SCOUT["Bacheca Recruiting & Scouting: Selezione Staff Tecnico, Medico e Fisio"]:::client
    end

    subgraph LANE_GATEWAY["CORSIA 2: API GATEWAY & ACCESS CONTROL"]
        GW_ELITE_INGRESS["Envoy Enterprise Gateway: mTLS, Role-Based JWT Tier 3 Elite"]:::gateway
        DEC_SECURITY_GATE{"Controllo Sicurezza: Certificato Organizzazione & Ruoli R1..R6 Validi?"}:::decision

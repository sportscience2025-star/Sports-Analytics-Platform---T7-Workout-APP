    %% Connessioni di Flusso ISO 5807
    START --> UI_GHOST_MODE
    UI_GHOST_MODE --> DEC_ELITE_ACTION
    DEC_ELITE_ACTION -- "VIP Lounges Serie A" --> UI_VIP_LOUNGES
    DEC_ELITE_ACTION -- "Booking Macchinari" --> UI_LAB_BOOKING
    DEC_ELITE_ACTION -- "Recruiting & Scouting" --> UI_STAFF_SCOUT

    UI_VIP_LOUNGES --> GW_ELITE_INGRESS
    UI_LAB_BOOKING --> GW_ELITE_INGRESS
    UI_STAFF_SCOUT --> GW_ELITE_INGRESS

    GW_ELITE_INGRESS --> DEC_SECURITY_GATE
    DEC_SECURITY_GATE -- "No / Certificato Invalido o Permesso Negato" --> GW_ERR_ELITE
    GW_ERR_ELITE --> UI_GHOST_MODE

    DEC_SECURITY_GATE -- "Si / Ghost Mode & Lounges" --> SRV_PRIVACY_ENCLAVE
    SRV_PRIVACY_ENCLAVE --> SRV_VAULT_ENCRYPT
    SRV_VAULT_ENCRYPT --> DB_SILO1_ELITE_LOUNGES

    DEC_SECURITY_GATE -- "Si / Prenotazione Macchinario" --> SRV_LAB_SCHEDULER
    SRV_LAB_SCHEDULER --> DB_SILO1_LABS_STAFF

    DEC_SECURITY_GATE -- "Si / Candidatura Staff" --> SRV_SCOUTING_MATCH
    SRV_SCOUTING_MATCH --> DB_SILO1_LABS_STAFF

    DB_SILO1_ELITE_LOUNGES --> END_FLOW
    DB_SILO1_LABS_STAFF --> END_FLOW
